[Desktop Entry]
Type=Application
Version=1.0
Name=Switch Desktop Environment
GenericName=Desktop Environment Switcher
Comment=Instantly hot-switch between KDE Plasma 6, GNOME, and Caelestia Shell (Hyprland)
Exec=/usr/bin/caelaris-switch-desktop
Icon=preferences-desktop-display
Terminal=false
Categories=System;Settings;Utility;
Keywords=switch;desktop;plasma;kde;gnome;caelestia;hyprland;session;
StartupNotify=true
