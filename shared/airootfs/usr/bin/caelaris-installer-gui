        self.txt_pass2.setEchoMode(QLineEdit.EchoMode.Password)
        self.txt_pass2.setText("caelaris")
        cl5.addWidget(self.txt_pass2)
        self.chk_autologin = QCheckBox("Log in automatically without asking for password on boot")
        cl5.addWidget(self.chk_autologin)
        l5.addWidget(c5)
        l5.addStretch()
        self.stack.addWidget(p5)

        # 6. Desktop
        p6 = QWidget()
        l6 = QVBoxLayout(p6)
        l6.addWidget(QLabel("Default Desktop", objectName="pageTitle"))
        l6.addWidget(QLabel("Select your primary desktop. Both KDE Plasma and GNOME are installed!", objectName="pageSubtitle"))
        c6 = QFrame(objectName="card")
        cl6 = QVBoxLayout(c6)
        self.rb_kde = QRadioButton("KDE Plasma 6 (Recommended) - Modern, fast, and customizable")
        self.rb_kde.setChecked(True)
        self.rb_gnome = QRadioButton("GNOME Desktop - Clean, elegant, distraction-free environment")
        cl6.addWidget(self.rb_kde)
        cl6.addSpacing(10)
        cl6.addWidget(self.rb_gnome)
