        self.rb_btrfs.setChecked(True)
        self.rb_ext4 = QRadioButton("Ext4 (Classic standard Linux)")
        cl4.addWidget(self.rb_btrfs)
        cl4.addWidget(self.rb_ext4)
        self.chk_zram = QCheckBox("Enable ZRAM swap (Low-latency RAM compression - Fedora/CachyOS default)")
        self.chk_zram.setChecked(True)
        cl4.addWidget(self.chk_zram)
        l4.addWidget(c4)
        l4.addStretch()
        self.stack.addWidget(p4)

        # 5. User Account
        p5 = QWidget()
        l5 = QVBoxLayout(p5)
