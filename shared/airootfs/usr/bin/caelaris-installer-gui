        cl1 = QVBoxLayout(c1)
        cl1.addWidget(QLabel("<b>Live Preview Active:</b> You can explore the system freely before installing."))
        cl1.addWidget(QLabel("✔ 64-bit modern x86_64 system ready"))
        cl1.addWidget(QLabel("✔ Dual session ready: KDE Plasma 6 & GNOME"))
        cl1.addWidget(QLabel("✔ PipeWire modern audio stack loaded"))
        l1.addWidget(c1)
        l1.addStretch()
        self.stack.addWidget(p1)

        # 2. Location
        p2 = QWidget()
        l2 = QVBoxLayout(p2)
        l2.addWidget(QLabel("Region & Timezone", objectName="pageTitle"))
        l2.addWidget(QLabel("Select your timezone for accurate clock synchronization.", objectName="pageSubtitle"))
        c2 = QFrame(objectName="card")
        cl2 = QVBoxLayout(c2)
