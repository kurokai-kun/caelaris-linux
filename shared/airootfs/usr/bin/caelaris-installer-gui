#!/usr/bin/env python3
"""
Caelaris Linux - Next-Generation Graphical System Installer
Written for Caelaris Linux (Arch-based Distribution)
Powered by PyQt6
"""

import sys
import os
import time
import subprocess
from pathlib import Path

from PyQt6.QtCore import Qt, QThread, pyqtSignal
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QStackedWidget, QLabel, QPushButton, QRadioButton,
    QCheckBox, QLineEdit, QComboBox, QProgressBar, QTextEdit,
    QFrame, QMessageBox
)

DARK_STYLE = """
QMainWindow { background-color: #0b0f19; }
QWidget { color: #f1f5f9; font-family: "Noto Sans", sans-serif; font-size: 13px; }
QFrame#sidebar { background-color: #070a12; border-right: 1px solid #1e293b; }
QLabel#sidebarTitle { color: #38bdf8; font-size: 18px; font-weight: bold; }
QLabel#stepItemActive {
    color: #38bdf8; font-weight: bold; font-size: 13px;
    padding: 8px 12px; background-color: rgba(56, 189, 248, 0.12);
    border-radius: 6px; border-left: 3px solid #38bdf8;
}
QLabel#stepItemInactive { color: #64748b; font-size: 13px; padding: 8px 12px; }
QLabel#stepItemDone { color: #10b981; font-size: 13px; padding: 8px 12px; }
QLabel#pageTitle { color: #f8fafc; font-size: 22px; font-weight: bold; }
QLabel#pageSubtitle { color: #94a3b8; font-size: 13px; margin-bottom: 8px; }
QFrame#card { background-color: #131b2e; border: 1px solid #1e293b; border-radius: 10px; padding: 14px; }
QLineEdit, QComboBox {
    background-color: #0f172a; border: 1px solid #334155;
    border-radius: 6px; padding: 7px 10px; color: #f8fafc;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #38bdf8; }
QPushButton {
    background-color: #1e293b; color: #f8fafc; border: 1px solid #334155;
    border-radius: 6px; padding: 8px 18px; font-weight: 600;
}
QPushButton:hover { background-color: #334155; }
QPushButton#primaryBtn { background-color: #0284c7; border: 1px solid #38bdf8; }
QPushButton#primaryBtn:hover { background-color: #0369a1; }
QPushButton#successBtn { background-color: #059669; border: 1px solid #10b981; padding: 10px 22px; }
QPushButton#successBtn:hover { background-color: #047857; }
QProgressBar {
    background-color: #0f172a; border: 1px solid #334155;
    border-radius: 6px; text-align: center; color: #ffffff; height: 20px;
}
QProgressBar::chunk { background-color: #0284c7; border-radius: 5px; }
QTextEdit#logView {
    background-color: #020617; border: 1px solid #1e293b;
    border-radius: 6px; color: #38bdf8; font-family: monospace; font-size: 11px;
}
"""

class InstallWorker(QThread):
    progress_changed = pyqtSignal(int, str)
    log_received = pyqtSignal(str)
    installation_finished = pyqtSignal(bool, str)

    def __init__(self, config):
        super().__init__()
        self.config = config

    def log(self, text):
        self.log_received.emit(text)

    def run_cmd(self, cmd, check=True):
        self.log(f"[EXEC] {' '.join(cmd) if isinstance(cmd, list) else cmd}")
        process = subprocess.Popen(
            cmd, shell=isinstance(cmd, str),
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1
        )
        for line in iter(process.stdout.readline, ''):
            clean = line.strip()
            if clean:
                # Suppress harmless legacy storage/network controller missing firmware warnings from mkinitcpio
                if "Possibly missing firmware" in clean or "missing firmware for module" in clean:
                    continue
                self.log(clean)
        process.stdout.close()
        ret = process.wait()
        if check and ret != 0:
            raise RuntimeError(f"Command failed ({ret}): {cmd}")
        return ret

    def run(self):
        try:
            cfg = self.config
            disk = cfg['disk']
            fs_type = cfg['filesystem']
            tz = cfg['timezone']
            user = cfg['username']
            realname = cfg['realname']
            password = cfg['password']
            hostname = cfg['hostname']
            autologin = cfg['autologin']
            desktop = cfg['desktop']
            import platform
            is_aarch64 = platform.machine().lower() in ["aarch64", "arm64"]

            self.progress_changed.emit(5, f"Preparing target disk {disk}...")
            self.run_cmd("umount -R /mnt 2>/dev/null || true", check=False)
            self.run_cmd("swapoff -a 2>/dev/null || true", check=False)

            self.progress_changed.emit(12, "Partitioning disk (GPT + EFI ESP + Root)...")
            self.run_cmd(f"wipefs -a -f {disk}", check=False)
            self.run_cmd(["sgdisk", "-Z", disk], check=False)
            self.run_cmd(["sgdisk", "-n", "1:0:+512M", "-t", "1:ef00", "-c", "1:EFI-SP", disk])
            self.run_cmd(["sgdisk", "-n", "2:0:0", "-t", "2:8300", "-c", "2:Caelaris-Root", disk])
            self.run_cmd(["partprobe", disk], check=False)
            time.sleep(2)

            p_prefix = "p" if ("nvme" in disk or "mmcblk" in disk) else ""
            p1 = f"{disk}{p_prefix}1"
            p2 = f"{disk}{p_prefix}2"

            self.progress_changed.emit(25, f"Formatting EFI partition ({p1})...")
            self.run_cmd(["mkfs.fat", "-F32", "-n", "ESP", p1])

            if fs_type == "btrfs":
                self.progress_changed.emit(32, f"Formatting Btrfs with subvolumes ({p2})...")
                self.run_cmd(["mkfs.btrfs", "-f", "-L", "caelaris", p2])
                self.run_cmd(["mount", p2, "/mnt"])
                for sv in ["@", "@home", "@snapshots", "@var_log", "@var_cache"]:
                    self.run_cmd(["btrfs", "subvolume", "create", f"/mnt/{sv}"])
                self.run_cmd(["umount", "/mnt"])

                mount_opts = "noatime,compress=zstd:1,space_cache=v2"
                self.run_cmd(["mount", "-o", f"{mount_opts},subvol=@", p2, "/mnt"])
                for d in ["home", ".snapshots", "var/log", "var/cache", "boot"]:
                    os.makedirs(f"/mnt/{d}", exist_ok=True)

                self.run_cmd(["mount", "-o", f"{mount_opts},subvol=@home", p2, "/mnt/home"])
                self.run_cmd(["mount", "-o", f"{mount_opts},subvol=@snapshots", p2, "/mnt/.snapshots"])
                self.run_cmd(["mount", "-o", f"{mount_opts},subvol=@var_log", p2, "/mnt/var/log"])
                self.run_cmd(["mount", "-o", f"{mount_opts},subvol=@var_cache", p2, "/mnt/var/cache"])
                # NOTE: ESP is mounted AFTER unsquashfs extraction at step 55 to avoid overwrite
            else:
                self.progress_changed.emit(32, f"Formatting Ext4 partition ({p2})...")
                self.run_cmd(["mkfs.ext4", "-F", "-L", "caelaris", p2])
                self.run_cmd(["mount", p2, "/mnt"])
                # NOTE: ESP is mounted AFTER unsquashfs extraction at step 55 to avoid overwrite


            self.progress_changed.emit(45, "Extracting Caelaris Linux system files...")
            sfs = None
            for cand in [
                "/run/archiso/bootmnt/arch/x86_64/airootfs.sfs",
                "/run/archiso/airootfs.sfs",
                "/run/archiso/bootmnt/live/filesystem.squashfs",
                "/live/filesystem.squashfs"
            ] + glob.glob("/run/archiso/**/filesystem.squashfs", recursive=True) + glob.glob("/run/archiso/**/airootfs.sfs", recursive=True):
                if os.path.isfile(cand):
                    sfs = cand
                    break
            if sfs:
                self.log(f"Extracting SquashFS image {sfs} to /mnt...")
                self.run_cmd(f"unsquashfs -f -d /mnt {sfs}")
            else:
                self.log("Syncing system files to /mnt via rsync...")
                self.run_cmd("rsync -aAXv --exclude={'/dev/*','/proc/*','/sys/*','/tmp/*','/run/*','/mnt/*','/lost+found'} / /mnt/", check=False)

            # Mount the EFI partition AFTER extraction (unsquashfs would wipe it otherwise)
            self.progress_changed.emit(55, "Mounting EFI System Partition...")
            os.makedirs("/mnt/boot/efi", exist_ok=True)
            self.run_cmd(["umount", "/mnt/boot/efi"], check=False)
            self.run_cmd(["mount", p1, "/mnt/boot/efi"])


            self.progress_changed.emit(68, "Generating /etc/fstab...")
            self.run_cmd("genfstab -U /mnt >> /mnt/etc/fstab")

            self.progress_changed.emit(75, "Configuring Hostname, Timezone & Locale...")
            with open("/mnt/etc/hostname", "w") as f:
                f.write(f"{hostname}\n")
            self.run_cmd(f"ln -sf /usr/share/zoneinfo/{tz} /mnt/etc/localtime", check=False)
            self.run_cmd("arch-chroot /mnt hwclock --systohc", check=False)
            with open("/mnt/etc/locale.gen", "w") as f:
                f.write("en_US.UTF-8 UTF-8\n")
            self.run_cmd("arch-chroot /mnt locale-gen", check=False)
            with open("/mnt/etc/locale.conf", "w") as f:
                f.write("LANG=en_US.UTF-8\n")

            self.progress_changed.emit(82, f"Configuring user '{user}' and desktop sessions...")
            self.run_cmd(f"arch-chroot /mnt useradd -m -c '{realname}' -g users -G wheel,video,audio,optical,storage,input,power,gamemode -s /bin/bash '{user}'", check=False)
            self.run_cmd(f"echo '{user}:{password}' | arch-chroot /mnt chpasswd")
            self.run_cmd(f"echo 'root:{password}' | arch-chroot /mnt chpasswd")
            with open("/mnt/etc/sudoers.d/wheel", "w") as f:
                f.write("%wheel ALL=(ALL:ALL) ALL\n")
            os.chmod("/mnt/etc/sudoers.d/wheel", 0o440)
            if os.path.exists("/mnt/etc/sudoers.d/g_wheel"):
                os.remove("/mnt/etc/sudoers.d/g_wheel")

            # Fully purge liveuser and sysusers config so only the created user profile remains
            self.run_cmd("arch-chroot /mnt userdel -r -f liveuser 2>/dev/null || true", check=False)
            for stale_live in [
                "/mnt/etc/sysusers.d/caelaris-liveuser.conf",
                "/mnt/var/lib/AccountsService/users/liveuser",
                "/mnt/etc/sudoers.d/liveuser",
                "/mnt/home/liveuser"
            ]:
                if os.path.isdir(stale_live):
                    shutil.rmtree(stale_live, ignore_errors=True)
                elif os.path.exists(stale_live):
                    os.remove(stale_live)

            os.makedirs("/mnt/var/lib/AccountsService/users", exist_ok=True)
            with open(f"/mnt/var/lib/AccountsService/users/{user}", "w") as f:
                f.write(f"[User]\nLanguage=en_US.UTF-8\nSession=plasma\nXSession=plasma\nSystemAccount=false\nRealName={realname}\nIcon=/usr/share/pixmaps/caelaris-logo.png\n")


            os.makedirs("/mnt/etc/sddm.conf.d", exist_ok=True)
            sddm_cfg = f"[Theme]\nCurrent=breeze\nCursorTheme=breeze_cursors\n"
            if autologin:
                sddm_cfg += f"\n[Autologin]\nUser={user}\nSession=plasma\nRelogin=false\n"
            with open("/mnt/etc/sddm.conf.d/10-caelaris.conf", "w") as f:
                f.write(sddm_cfg)

            # ── Ensure Linux Kernel & Microcodes exist in /mnt/boot ──────────
            self.progress_changed.emit(85, "Installing Linux Kernel & Microcode binaries...")
            os.makedirs("/mnt/boot", exist_ok=True)
            import glob, shutil

            # 1. Locate and copy kernel vmlinuz-linux or Image
            k_copied = False
            k_modules = glob.glob("/mnt/usr/lib/modules/*/vmlinuz") + glob.glob("/mnt/usr/lib/modules/*/vmlinuz*") + glob.glob("/mnt/usr/lib/modules/*/Image*")
            if k_modules and os.path.isfile(k_modules[0]):
                self.log(f"Copying kernel from {k_modules[0]} to /mnt/boot/vmlinuz-linux...")
                shutil.copy2(k_modules[0], "/mnt/boot/vmlinuz-linux")
                k_copied = True

            if not k_copied:
                for cand in [
                    "/run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux",
                    "/run/archiso/bootmnt/live/vmlinuz",
                    "/live/vmlinuz",
                    "/boot/Image",
                    "/boot/vmlinuz-linux",
                    "/boot/vmlinuz-linux-aarch64",
                ] + glob.glob("/run/archiso/bootmnt/**/vmlinuz*", recursive=True) + glob.glob("/run/archiso/bootmnt/**/Image*", recursive=True):
                    if os.path.isfile(cand):
                        self.log(f"Copying kernel from {cand} to /mnt/boot/vmlinuz-linux...")
                        shutil.copy2(cand, "/mnt/boot/vmlinuz-linux")
                        k_copied = True
                        break

            if k_copied:
                os.chmod("/mnt/boot/vmlinuz-linux", 0o755)
                self.log(f"[OK] Kernel placed: /mnt/boot/vmlinuz-linux ({os.path.getsize('/mnt/boot/vmlinuz-linux')} bytes)")
            else:
                self.log("[ERROR] Could not find vmlinuz kernel binary to copy into /mnt/boot!")

            # 2. Copy CPU microcodes (intel-ucode.img, amd-ucode.img)
            for ucode_name in ["intel-ucode.img", "amd-ucode.img"]:
                for u_cand in [
                    f"/run/archiso/bootmnt/arch/boot/{ucode_name}",
                    f"/boot/{ucode_name}",
                ] + glob.glob(f"/run/archiso/bootmnt/**/{ucode_name}", recursive=True):
                    if os.path.isfile(u_cand):
                        self.log(f"Copying microcode {ucode_name} from {u_cand}...")
                        shutil.copy2(u_cand, f"/mnt/boot/{ucode_name}")
                        break

            # 3. Clean mkinitcpio configuration for installed system
            if os.path.exists("/mnt/etc/mkinitcpio.conf.d/archiso.conf"):
                self.log("Removing live archiso.conf from target mkinitcpio...")
                os.remove("/mnt/etc/mkinitcpio.conf.d/archiso.conf")

            os.makedirs("/mnt/etc/mkinitcpio.d", exist_ok=True)
            with open("/mnt/etc/mkinitcpio.d/linux.preset", "w") as f:
                f.write(
                    '# mkinitcpio preset file for the linux package\n'
                    'ALL_config="/etc/mkinitcpio.conf"\n'
                    'ALL_kver="/boot/vmlinuz-linux"\n\n'
                    "PRESETS=('default' 'fallback')\n\n"
                    'default_config="/etc/mkinitcpio.conf"\n'
                    'default_image="/boot/initramfs-linux.img"\n\n'
                    'fallback_config="/etc/mkinitcpio.conf"\n'
                    'fallback_image="/boot/initramfs-linux-fallback.img"\n'
                    'fallback_options="-S autodetect"\n'
                )

            with open("/mnt/etc/mkinitcpio.conf", "w") as f:
                f.write(
                    'MODULES=()\n'
                    'BINARIES=()\n'
                    'FILES=()\n'
                    'HOOKS=(base udev autodetect modconf kms keyboard keymap consolefont block btrfs filesystems fsck)\n'
                )

            # Ensure /etc/mtab is a symlink for grub-probe
            self.run_cmd("ln -sf /proc/self/mounts /mnt/etc/mtab", check=False)

            self.progress_changed.emit(88, "Configuring Bootloader (GRUB + UEFI/BIOS support)...")
            is_efi = os.path.exists("/sys/firmware/efi")
            subvol_arg = "rootflags=subvol=@" if fs_type == "btrfs" else ""

            # ── Write /etc/default/grub ──────────────────────────────────────
            os.makedirs("/mnt/etc/default", exist_ok=True)
            with open("/mnt/etc/default/grub", "w") as f:
                f.write(
                    'GRUB_DEFAULT=0\n'
                    'GRUB_TIMEOUT=2\n'
                    'GRUB_TIMEOUT_STYLE=menu\n'
                    'GRUB_DISTRIBUTOR="Caelaris"\n'
                    f'GRUB_CMDLINE_LINUX_DEFAULT="{subvol_arg} quiet loglevel=3 rd.udev.log_level=3 systemd.show_status=0 vt.global_cursor_default=0 video=1920x1080"\n'
                    'GRUB_CMDLINE_LINUX=""\n'
                    'GRUB_GFXMODE=1920x1080,auto\n'
                    'GRUB_GFXPAYLOAD_LINUX=keep\n'
                    'GRUB_DISABLE_OS_PROBER=false\n'
                )

            # Remove any stale custom menu entries from old installs
            for stale in ["/mnt/etc/grub.d/15_caelaris_gnome"]:
                if os.path.exists(stale):
                    os.remove(stale)

            # ── Step 1: Ensure firmware stubs exist & regenerate initramfs ──────
            self.progress_changed.emit(90, "Configuring firmware and generating initramfs with mkinitcpio...")
            fw_dir = "/mnt/usr/lib/firmware"
            os.makedirs(fw_dir, exist_ok=True)
            for fw in [
                "aic94xx-seq.fw", "wd719x-wds.bin", "wd719x-risc.bin",
                "ast_dp501_fw.bin", "qla1280.bin", "ql2100_fw.bin", "ql2200_fw.bin",
                "ql2300_fw.bin", "ql2322_fw.bin", "ql2400_fw.bin", "ql2500_fw.bin",
                "bfa/bfa_fw.bin", "bfa/bfa_fw_3.0.0.0.bin", "bfa/cna_2322.bin",
                "qed/qed_init_values_zipped-8.70.16.0.bin", "qed/qed_init_values_zipped-8.42.2.0.bin",
                "qed/qed_init_values_zipped-8.37.7.0.bin", "qed/qed_init_values_zipped-8.33.12.0.bin",
                "qed/qed_init_values_zipped-8.33.1.0.bin", "qed/qed_init_values_zipped-8.20.0.0.bin",
                "qed/qed_init_values_zipped-8.10.10.0.bin", "qed/qed_init_values_zipped-8.10.9.0.bin",
                "qed/qed_init_values_zipped-8.10.7.0.bin", "qed/qed_init_values_zipped-8.10.5.0.bin",
                "qed/qed_init_values_zipped-8.7.3.0.bin", "qed/qed_init_values_zipped-8.4.2.0.bin",
                "liquidio/lio_23xx_vfs.bin", "liquidio/lio_23xx_nic.bin", "liquidio/lio_410nv_nic.bin"
            ]:
                dest = os.path.join(fw_dir, fw)
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                if not os.path.exists(dest):
                    try:
                        open(dest, "a").close()
                    except OSError:
                        pass

            self.run_cmd("arch-chroot /mnt mkinitcpio -P", check=False)

            # ── Step 2: Install GRUB bootloader ──────────────────────────────
            self.progress_changed.emit(92, "Installing GRUB bootloader...")
            os.makedirs("/mnt/boot/grub", exist_ok=True)

            if is_efi:
                os.makedirs("/mnt/boot/efi", exist_ok=True)
                self.run_cmd(f"mountpoint -q /mnt/boot/efi || mount {p1} /mnt/boot/efi", check=False)
                if is_aarch64:
                    self.log("ARM64 UEFI detected — installing GRUB ARM64 EFI with removable fallback...")
                    # Primary NVRAM EFI entry
                    self.run_cmd("arch-chroot /mnt grub-install --target=arm64-efi --efi-directory=/boot/efi --bootloader-id=Caelaris --recheck", check=False)
                    # Universal Removable fallback EFI entry (EFI/BOOT/BOOTAA64.EFI for Apple Silicon UTM & Snapdragon laptops)
                    self.run_cmd("arch-chroot /mnt grub-install --target=arm64-efi --efi-directory=/boot/efi --bootloader-id=Caelaris --removable --no-nvram --recheck", check=False)
                else:
                    self.log("x86_64 UEFI detected — installing GRUB EFI with removable fallback...")
                    # Primary NVRAM EFI entry
                    self.run_cmd("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Caelaris --recheck", check=False)
                    # Universal Removable fallback EFI entry (EFI/BOOT/BOOTX64.EFI for VMware/VirtualBox/UTM)
                    self.run_cmd("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Caelaris --removable --no-nvram --recheck", check=False)
            else:
                self.log(f"BIOS detected — installing GRUB MBR on {disk}...")
                self.run_cmd(f"arch-chroot /mnt grub-install --target=i386-pc --recheck {disk}", check=False)

            # ── Step 3: Generate grub.cfg ─────────────────────────────────────
            self.progress_changed.emit(94, "Generating GRUB menu configuration...")
            self.run_cmd("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg", check=False)

            # ── Clean up menu titles: Show ONLY "Caelaris Linux" ────────────
            grub_cfg_file = "/mnt/boot/grub/grub.cfg"
            if os.path.isfile(grub_cfg_file):
                with open(grub_cfg_file, "r") as f:
                    cfg_text = f.read()

                cfg_text = cfg_text.replace("Caelaris Linux, with Linux linux", "Caelaris Linux")
                cfg_text = cfg_text.replace("Caelaris Linux linux", "Caelaris Linux")
                cfg_text = cfg_text.replace("Caelaris linux", "Caelaris Linux")
                cfg_text = cfg_text.replace("with Linux linux", "Caelaris Linux")
                cfg_text = cfg_text.replace("Caelaris Linux, with Linux linux (fallback initramfs)", "Caelaris Linux (Recovery Mode)")
                cfg_text = cfg_text.replace("Caelaris Linux (fallback initramfs)", "Caelaris Linux (Recovery Mode)")

                with open(grub_cfg_file, "w") as f:
                    f.write(cfg_text)

            # ── Step 3b: Verify and guarantee Linux boot entry in grub.cfg ───
            has_linux = False
            if os.path.isfile(grub_cfg_file):
                with open(grub_cfg_file, "r") as f:
                    cfg_text = f.read()
                if "vmlinuz" in cfg_text:
                    has_linux = True
                    self.log("[SUCCESS] Verified clean Caelaris Linux boot entry present in grub.cfg!")

            if not has_linux:
                self.log("[WARNING] Generating bulletproof Caelaris Linux entry...")
                root_uuid = subprocess.check_output(f"blkid -s UUID -o value {p2}", shell=True, text=True).strip()
                subvol_flag = "rootflags=subvol=@ " if fs_type == "btrfs" else ""
                k_path = "/@/boot/vmlinuz-linux" if fs_type == "btrfs" else "/boot/vmlinuz-linux"
                initrd_path = "/@/boot/initramfs-linux.img" if fs_type == "btrfs" else "/boot/initramfs-linux.img"
                ucode_str = ""
                if os.path.isfile("/mnt/boot/intel-ucode.img"):
                    ucode_str = ("/@/boot/intel-ucode.img " if fs_type == "btrfs" else "/boot/intel-ucode.img ")
                elif os.path.isfile("/mnt/boot/amd-ucode.img"):
                    ucode_str = ("/@/boot/amd-ucode.img " if fs_type == "btrfs" else "/boot/amd-ucode.img ")

                guaranteed_entry = f"""
menuentry "Caelaris Linux" --class caelaris --class kde --class gnu-linux --class gnu --class os {{
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod part_msdos
    insmod {fs_type}
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux {k_path} root=UUID={root_uuid} rw {subvol_flag}quiet loglevel=3 rd.udev.log_level=3 systemd.show_status=0 vt.global_cursor_default=0 video=1920x1080
    initrd {ucode_str}{initrd_path}
}}
"""
                existing_cfg = ""
                if os.path.isfile(grub_cfg_file):
                    with open(grub_cfg_file, "r") as f:
                        existing_cfg = f.read()
                with open(grub_cfg_file, "w") as f:
                    f.write(guaranteed_entry + "\n" + existing_cfg)
                self.log("[SUCCESS] Guaranteed Caelaris Linux entry injected as default in grub.cfg!")

            # ── Step 4: Enable pacman keys for online use ─────────────────────
            self.run_cmd("arch-chroot /mnt pacman-key --init 2>/dev/null || true", check=False)
            pop_key = "archlinuxarm" if is_aarch64 else "archlinux"
            self.run_cmd(f"arch-chroot /mnt pacman-key --populate {pop_key} 2>/dev/null || true", check=False)

            # ── Step 5: Install & Enable All Hardware & Virtualization Drivers ───
            self.progress_changed.emit(96, "Installing and enabling hardware drivers & guest tools...")
            self.run_cmd(
                "arch-chroot /mnt systemctl enable NetworkManager sddm pipewire wireplumber "
                "vboxservice vmtoolsd vmware-vmblock-fuse spice-vdagentd qemu-guest-agent "
                "systemd-timesyncd ananicy-cpp 2>/dev/null || true",
                check=False
            )

            # Enable NVIDIA modesetting if NVIDIA hardware is present
            try:
                pci_output = subprocess.check_output("lspci", shell=True, text=True)
                if "nvidia" in pci_output.lower():
                    os.makedirs("/mnt/etc/modprobe.d", exist_ok=True)
                    with open("/mnt/etc/modprobe.d/nvidia.conf", "w") as f:
                        f.write("options nvidia-drm modeset=1\n")
                    self.log("Configured NVIDIA DRM modesetting for installed system.")
            except Exception:
                pass

            # ── Step 6: Clean up live-environment artifacts & installer shortcuts ─
            self.progress_changed.emit(98, "Cleaning up live-system artifacts & removing installer from desktop...")
            for live_artifact in [
                "/mnt/etc/systemd/system/caelaris-live-setup.service",
                "/mnt/etc/systemd/system/graphical.target.wants/caelaris-live-setup.service",
                "/mnt/usr/bin/caelaris-live-setup",
                "/mnt/etc/sddm.conf.d/autologin.conf",
                "/mnt/etc/sudoers.d/liveuser",
                "/mnt/etc/sudoers.d/g_wheel",
                "/mnt/etc/sysusers.d/caelaris-liveuser.conf",
                "/mnt/var/lib/AccountsService/users/liveuser",
                # Remove installer desktop shortcuts so installer completely disappears from desktop
                f"/mnt/home/{user}/Desktop/install-caelaris.desktop",
                "/mnt/etc/skel/Desktop/install-caelaris.desktop",
                "/mnt/usr/share/applications/install-caelaris.desktop",
                "/mnt/usr/share/applications/caelaris-installer.desktop",
                "/mnt/usr/share/applications/caelaris-installer-gui.desktop"
            ]:
                if os.path.isdir(live_artifact):
                    shutil.rmtree(live_artifact, ignore_errors=True)
                elif os.path.exists(live_artifact):
                    try:
                        os.remove(live_artifact)
                    except OSError:
                        pass

            # Remove any stray switch-to-*.desktop
            import glob
            for shortcut in glob.glob(f"/mnt/home/{user}/Desktop/switch-to-*.desktop") + glob.glob("/mnt/etc/skel/Desktop/switch-to-*.desktop"):
                try:
                    os.remove(shortcut)
                except OSError:
                    pass

            # Clean up GNOME & KDE desktop application menus so each environment has a clean, dedicated app drawer
            self.log("Polishing GNOME & KDE application drawers for a clean experience...")
            kde_exclusive_apps = [
                "org.kde.dolphin", "dolphin", "org.kde.konsole", "konsole",
                "org.kde.kate", "kate", "org.kde.kwrite", "kwrite",
                "org.kde.ark", "ark", "org.kde.spectacle", "spectacle",
                "org.kde.gwenview", "gwenview", "org.kde.kcalc", "kcalc",
                "org.kde.plasma-systemmonitor", "plasma-systemmonitor",
                "systemsettings", "kinfocenter", "org.kde.discover",
                "org.kde.drkonqi", "org.kde.plasma.vault"
            ]
            gnome_exclusive_apps = [
                "org.gnome.Nautilus", "nautilus", "org.gnome.Ptyxis", "ptyxis",
                "org.gnome.TextEditor", "gnome-text-editor",
                "org.gnome.Calculator", "gnome-calculator",
                "org.gnome.SystemMonitor", "gnome-system-monitor",
                "org.gnome.DiskUtility", "gnome-disk-utility",
                "gnome-control-center", "org.gnome.Settings"
            ]
            utility_clutter = [
                "avahi-discover", "bssh", "bvnc", "qv4l2", "qvidcap",
                "lstopo", "cmake-gui", "electron", "electron31", "electron32", "electron33"
            ]

            for kapp in kde_exclusive_apps:
                df = f"/mnt/usr/share/applications/{kapp}.desktop"
                if os.path.isfile(df):
                    try:
                        with open(df, "r") as f:
                            c = f.read()
                        lines = [l for l in c.splitlines() if not l.startswith("NotShowIn=") and not l.startswith("OnlyShowIn=")]
                        lines.append("NotShowIn=GNOME;")
                        with open(df, "w") as f:
                            f.write("\n".join(lines) + "\n")
                    except Exception:
                        pass

            for gapp in gnome_exclusive_apps:
                df = f"/mnt/usr/share/applications/{gapp}.desktop"
                if os.path.isfile(df):
                    try:
                        with open(df, "r") as f:
                            c = f.read()
                        lines = [l for l in c.splitlines() if not l.startswith("NotShowIn=") and not l.startswith("OnlyShowIn=")]
                        lines.append("NotShowIn=KDE;")
                        with open(df, "w") as f:
                            f.write("\n".join(lines) + "\n")
                    except Exception:
                        pass

            for util in utility_clutter:
                df = f"/mnt/usr/share/applications/{util}.desktop"
                if os.path.isfile(df):
                    try:
                        with open(df, "r") as f:
                            c = f.read()
                        if "NoDisplay=true" not in c:
                            with open(df, "a") as f:
                                f.write("\nNoDisplay=true\n")
                    except Exception:
                        pass

            # Ensure clean per-device uniqueness: sanitize /etc/machine-id and SSH host keys
            try:
                if os.path.exists("/mnt/etc/machine-id"):
                    open("/mnt/etc/machine-id", "w").close()
                for hk in glob.glob("/mnt/etc/ssh/ssh_host_*"):
                    os.remove(hk)
            except Exception:
                pass

            # Ensure proper ownership of user home directory
            self.run_cmd(f"arch-chroot /mnt chown -R {user}:users /home/{user}", check=False)

            self.progress_changed.emit(100, "Installation complete!")
            self.installation_finished.emit(True, "Caelaris Linux installed successfully!")

        except Exception as e:
            self.log(f"[ERROR] {str(e)}")
            self.installation_finished.emit(False, str(e))

class CaelarisInstaller(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Caelaris Linux Installer")
        self.resize(960, 620)
        self.setStyleSheet(DARK_STYLE)

        self.current_step = 0
        self.step_names = [
            "Welcome", "Location", "Keyboard", "Partitions",
            "User Account", "Desktop", "Third-Party Apps",
            "Summary", "Installing", "Finished"
        ]
        self.init_ui()

    def init_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QHBoxLayout(central)
        main_layout.setContentsMargins(0, 0, 0, 0)
        main_layout.setSpacing(0)

        # Left Sidebar
        sidebar = QFrame()
        sidebar.setObjectName("sidebar")
        sidebar.setFixedWidth(220)
        side_layout = QVBoxLayout(sidebar)
        side_layout.setContentsMargins(18, 20, 18, 20)
        side_layout.setSpacing(4)

        logo = QLabel("✨ Caelaris Linux")
        logo.setObjectName("sidebarTitle")
        side_layout.addWidget(logo)
        desc = QLabel("System Installer")
        desc.setStyleSheet("color: #64748b; font-size: 11px; margin-bottom: 12px;")
        side_layout.addWidget(desc)

        self.step_labels = []
        for i, name in enumerate(self.step_names):
            lbl = QLabel(f"{i+1}. {name}")
            lbl.setObjectName("stepItemInactive")
            self.step_labels.append(lbl)
            side_layout.addWidget(lbl)

        side_layout.addStretch()
        main_layout.addWidget(sidebar)

        # Content Area
        content = QWidget()
        c_layout = QVBoxLayout(content)
        c_layout.setContentsMargins(32, 24, 32, 20)
        c_layout.setSpacing(14)

        self.stack = QStackedWidget()
