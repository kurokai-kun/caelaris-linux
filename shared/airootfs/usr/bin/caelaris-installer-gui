        self.stack.addWidget(p9)

        # 10. Finished
        p10 = QWidget()
        l10 = QVBoxLayout(p10)
        l10.addWidget(QLabel("Installation Complete! 🎉", objectName="pageTitle"))
        l10.addWidget(QLabel("Caelaris Linux has been installed successfully.", objectName="pageSubtitle"))
        c10 = QFrame(objectName="card")
        cl10 = QVBoxLayout(c10)
        cl10.addWidget(QLabel("Restart your computer to boot into your new Caelaris Linux system."))
        self.chk_reboot = QCheckBox("Restart computer now")
        self.chk_reboot.setChecked(True)
        cl10.addWidget(self.chk_reboot)
        l10.addWidget(c10)
        l10.addStretch()
        btn_done = QPushButton("Done", objectName="successBtn")
        btn_done.clicked.connect(self.finish_installation)
        l10.addWidget(btn_done)
        self.stack.addWidget(p10)

    def populate_cities(self, region):
        cities = {
            "America": ["New_York", "Chicago", "Los_Angeles", "Toronto", "Sao_Paulo", "Mexico_City"],
            "Europe": ["London", "Paris", "Berlin", "Rome", "Madrid", "Amsterdam"],
            "Asia": ["Tokyo", "Kolkata", "Singapore", "Seoul", "Dubai", "Shanghai"],
            "Australia": ["Sydney", "Melbourne", "Perth"],
            "Africa": ["Cairo", "Johannesburg", "Nairobi"],
            "Pacific": ["Auckland", "Honolulu"]
        }
        self.cb_city.clear()
        self.cb_city.addItems(cities.get(region, ["UTC"]))

    def populate_disks(self):
        self.cb_disks.clear()
        found = False
        try:
            out = subprocess.check_output(["lsblk", "-d", "-n", "-o", "NAME,SIZE,MODEL,TYPE"], text=True)
            for line in out.strip().split("\n"):
                parts = line.split()
                if len(parts) >= 2 and parts[-1] == "disk":
                    name, size = parts[0], parts[1]
                    if not name.startswith("loop") and not name.startswith("zram"):
                        self.cb_disks.addItem(f"/dev/{name} ({size})", f"/dev/{name}")
                        found = True
        except Exception:
            pass
        if not found:
            self.cb_disks.addItem("/dev/sda (20.0G - Virtual Disk)", "/dev/sda")

    def update_step_ui(self):
        for i, lbl in enumerate(self.step_labels):
            if i < self.current_step:
                lbl.setObjectName("stepItemDone")
                lbl.setText(f"✔ {self.step_names[i]}")
            elif i == self.current_step:
                lbl.setObjectName("stepItemActive")
                lbl.setText(f"{i+1}. {self.step_names[i]}")
            else:
                lbl.setObjectName("stepItemInactive")
                lbl.setText(f"{i+1}. {self.step_names[i]}")
            lbl.style().unpolish(lbl)
            lbl.style().polish(lbl)

        self.btn_back.setEnabled(self.current_step > 0)
        if self.current_step == 7:
            self.btn_next.setText("Install Now 🚀")
            self.btn_next.setObjectName("successBtn")
        elif self.current_step >= 8:
            self.btn_back.setVisible(False)
            self.btn_next.setVisible(False)
        else:
            self.btn_next.setText("Next ▶")
            self.btn_next.setObjectName("primaryBtn")
        self.btn_next.style().unpolish(self.btn_next)
        self.btn_next.style().polish(self.btn_next)

    def next_page(self):
        if self.current_step == 4:
            if not self.txt_username.text().strip():
                QMessageBox.warning(self, "Input Error", "Please enter a valid username.")
                return
            if self.txt_pass1.text() != self.txt_pass2.text():
                QMessageBox.warning(self, "Password Error", "Passwords do not match.")
                return
        if self.current_step == 6:
            self.update_summary()
        if self.current_step == 7:
            confirm = QMessageBox.question(
                self, "Confirm Installation",
                f"Are you sure you want to write Caelaris Linux to {self.cb_disks.currentData()}?\nExisting data will be erased.",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
            )
            if confirm != QMessageBox.StandardButton.Yes:
                return
            self.start_installation()
            return
        if self.current_step < len(self.step_names) - 1:
            self.current_step += 1
            self.stack.setCurrentIndex(self.current_step)
            self.update_step_ui()

    def prev_page(self):
        if self.current_step > 0:
            self.current_step -= 1
            self.stack.setCurrentIndex(self.current_step)
            self.update_step_ui()

    def update_summary(self):
        fs = "Btrfs" if self.rb_btrfs.isChecked() else "Ext4"
        tz = f"{self.cb_region.currentText()}/{self.cb_city.currentText()}"
        dt = "KDE Plasma 6" if self.rb_kde.isChecked() else "GNOME Desktop"
        self.summary_text.setText(
            f"<b>Target Disk:</b> {self.cb_disks.currentText()}<br>"
            f"<b>Filesystem:</b> {fs}<br>"
            f"<b>Timezone:</b> {tz}<br>"
            f"<b>User:</b> {self.txt_realname.text()} ({self.txt_username.text()})<br>"
            f"<b>Default Desktop:</b> {dt}<br>"
            f"<b>Third-Party Apps:</b> Codecs, Flathub, Extra Drivers enabled"
        )

    def start_installation(self):
        self.current_step = 8
        self.stack.setCurrentIndex(self.current_step)
        self.update_step_ui()

        config = {
            'disk': self.cb_disks.currentData(),
            'filesystem': "btrfs" if self.rb_btrfs.isChecked() else "ext4",
            'timezone': f"{self.cb_region.currentText()}/{self.cb_city.currentText()}",
            'username': self.txt_username.text().strip(),
            'realname': self.txt_realname.text().strip(),
            'password': self.txt_pass1.text(),
            'hostname': self.txt_hostname.text().strip(),
            'autologin': self.chk_autologin.isChecked(),
            'desktop': "plasma" if self.rb_kde.isChecked() else "gnome"
        }

        self.worker = InstallWorker(config)
        self.worker.progress_changed.connect(lambda p, m: (self.progress_bar.setValue(p), self.ins_status.setText(m)))
        self.worker.log_received.connect(lambda t: (self.log_view.append(t), self.log_view.verticalScrollBar().setValue(self.log_view.verticalScrollBar().maximum())))
        self.worker.installation_finished.connect(self.on_finish)
        self.worker.start()

    def on_finish(self, success, message):
        if success:
            self.current_step = 9
            self.stack.setCurrentIndex(self.current_step)
            self.update_step_ui()
        else:
            QMessageBox.critical(self, "Installation Failed", message)

    def finish_installation(self):
        if self.chk_reboot.isChecked():
            subprocess.run(["systemctl", "reboot"], check=False)
        self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    installer = CaelarisInstaller()
    installer.show()
    sys.exit(app.exec())
