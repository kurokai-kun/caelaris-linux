        c5 = QFrame(objectName="card")
        cl5 = QVBoxLayout(c5)
        cl5.addWidget(QLabel("Full Name (Display Name):"))
        self.txt_realname = QLineEdit()
        self.txt_realname.setText("Caelaris User")
        cl5.addWidget(self.txt_realname)
        cl5.addWidget(QLabel("Username:"))
        self.txt_username = QLineEdit()
        self.txt_username.setText("user")
        cl5.addWidget(self.txt_username)
        cl5.addWidget(QLabel("Hostname:"))
        self.txt_hostname = QLineEdit()
        self.txt_hostname.setText("caelaris-pc")
        cl5.addWidget(self.txt_hostname)
        cl5.addWidget(QLabel("Password:"))
        self.txt_pass1 = QLineEdit()
        self.txt_pass1.setEchoMode(QLineEdit.EchoMode.Password)
        self.txt_pass1.setText("caelaris")
