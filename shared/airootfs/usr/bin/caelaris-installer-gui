        self.ins_status.setStyleSheet("color: #38bdf8; font-size: 14px; font-weight: bold;")
        l9.addWidget(self.ins_status)
        self.progress_bar = QProgressBar()
        l9.addWidget(self.progress_bar)
        self.log_view = QTextEdit(objectName="logView")
