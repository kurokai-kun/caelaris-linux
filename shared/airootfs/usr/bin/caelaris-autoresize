#!/bin/bash
# caelaris-autoresize: Enforce 1920x1080 resolution and dynamic scaling for VirtualBox / VM guests

# 1. Wait a moment for the compositor and display outputs to initialize
sleep 2

# 2. KDE Plasma (Wayland / X11) via kscreen-doctor
if which kscreen-doctor >/dev/null 2>&1; then
    for out in $(kscreen-doctor -o 2>/dev/null | grep -o 'Output: [0-9]\+' | awk '{print $2}'); do
        kscreen-doctor "output.${out}.mode.1920x1080@60" 2>/dev/null || \
        kscreen-doctor "output.${out}.mode.1920x1080" 2>/dev/null || \
        kscreen-doctor "output.${out}.mode.1600x900" 2>/dev/null || \
        kscreen-doctor "output.${out}.mode.1366x768" 2>/dev/null || true
    done
fi

# 3. GNOME / X11 via xrandr
if which xrandr >/dev/null 2>&1 && [ -n "$DISPLAY" ]; then
    xrandr -s 1920x1080 2>/dev/null || xrandr -s 1600x900 2>/dev/null || xrandr -s 1366x768 2>/dev/null || true
fi

# 4. VirtualBox userspace integration
if which VBoxClient >/dev/null 2>&1; then
    VBoxClient --clipboard 2>/dev/null || true
    VBoxClient --draganddrop 2>/dev/null || true
    VBoxClient --seamless 2>/dev/null || true
    VBoxClient --vmsvga 2>/dev/null || true
fi
