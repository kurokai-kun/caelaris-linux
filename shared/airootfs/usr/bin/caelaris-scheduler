#!/usr/bin/env bash
# ==============================================================================
# Caelaris Linux Scheduler Switcher (caelaris-scheduler)
# Manage sched-ext (eBPF) user-space CPU schedulers (scx_lavd, scx_bpfland,
# scx_rusty, scx_flash) or revert to default tuned EEVDF / BORE.
# ==============================================================================

set -euo pipefail

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
BOLD='\033[1m'
NC='\033[0m'

show_status() {
    echo -e "${CYAN}Caelaris CPU Scheduler Status:${NC}"
    if [ -f /sys/kernel/sched_ext/state ]; then
        state=$(cat /sys/kernel/sched_ext/state 2>/dev/null || echo "unknown")
        ops=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo "none")
        echo -e "  sched-ext state : ${BOLD}${state}${NC}"
        echo -e "  active scx ops  : ${BOLD}${ops}${NC}"
    else
        echo -e "  sched-ext       : ${YELLOW}Not active (using kernel EEVDF/BORE)${NC}"
    fi
    if systemctl is-active --quiet scx.service 2>/dev/null; then
        echo -e "  scx.service     : ${GREEN}active${NC}"
    else
        echo -e "  scx.service     : inactive"
    fi
}

if [ "${1:-}" = "status" ]; then
    show_status
    exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

CHOICE="${1:-}"
if [ -z "$CHOICE" ]; then
    show_status
    echo
    echo "Select CPU Scheduler:"
    echo "  1) scx_lavd     — Gaming & ultra-low desktop latency (Recommended)"
    echo "  2) scx_bpfland  — Interactive desktop responsiveness"
    echo "  3) scx_rusty    — Multi-core throughput & compilation"
    echo "  4) scx_flash    — Balanced low-latency fairness"
    echo "  5) default      — Disable sched-ext (use kernel EEVDF / BORE)"
    echo
    read -r -p "Choice [1-5]: " num
    case "$num" in
        1) CHOICE="scx_lavd" ;;
        2) CHOICE="scx_bpfland" ;;
        3) CHOICE="scx_rusty" ;;
        4) CHOICE="scx_flash" ;;
        5) CHOICE="default" ;;
        *) echo "Invalid choice."; exit 1 ;;
    esac
fi

if [ "$CHOICE" = "default" ] || [ "$CHOICE" = "eevdf" ] || [ "$CHOICE" = "bore" ]; then
    systemctl disable --now scx.service 2>/dev/null || true
    echo -e "${GREEN}[OK]${NC} Reverted to kernel default scheduler (EEVDF / BORE)."
    exit 0
fi

if ! command -v "$CHOICE" >/dev/null 2>&1; then
    echo -e "${RED}[ERROR]${NC} Scheduler binary '$CHOICE' not found. Install 'scx-scheds' first."
    exit 1
fi

mkdir -p /etc/default
cat > /etc/default/scx << EOF
SCX_SCHEDULER=${CHOICE}
SCX_FLAGS=""
EOF

systemctl enable --now scx.service
echo -e "${GREEN}[OK]${NC} Activated ${BOLD}${CHOICE}${NC} persistently via scx.service."
