#!/usr/bin/env bash
# Caelaris Linux System Installer Launcher
set +e

LOGFILE="/tmp/caelaris-installer.log"
exec > >(tee -a "$LOGFILE") 2>&1

echo "=============================================="
echo " Starting Caelaris Linux Installer            "
echo "=============================================="
echo "[*] Date: $(date)"
echo "[*] User: $(whoami) (UID: $(id -u))"
echo "[*] DISPLAY: ${DISPLAY:-none}"
echo "[*] WAYLAND_DISPLAY: ${WAYLAND_DISPLAY:-none}"
echo "[*] XDG_RUNTIME_DIR: ${XDG_RUNTIME_DIR:-none}"

USER_UID="$(id -u)"
USER_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/${USER_UID}}"

# 1. Authorize root on X11 / XWayland
if command -v xhost >/dev/null 2>&1; then
    xhost +SI:localuser:root 2>/dev/null || true
    xhost +local:root 2>/dev/null || true
    xhost +local: 2>/dev/null || true
    xhost + 2>/dev/null || true
fi

# 2. Grant open permissions to Wayland socket for root access
if [ -d "$USER_RUNTIME" ]; then
    chmod 777 "$USER_RUNTIME" 2>/dev/null || true
    for sock in "$USER_RUNTIME"/wayland-*; do
        [ -e "$sock" ] && chmod 777 "$sock" 2>/dev/null || true
    done
fi

# 3. Grant read access to XAUTHORITY
if [ -n "$XAUTHORITY" ] && [ -f "$XAUTHORITY" ]; then
    chmod 666 "$XAUTHORITY" 2>/dev/null || true
fi

export DISPLAY="${DISPLAY:-:0}"

# 4. If already root, launch directly
if [ "$USER_UID" -eq 0 ]; then
    if [ -x /usr/bin/caelaris-installer-gui ] || [ -f /usr/bin/caelaris-installer-gui ]; then
        QT_QPA_PLATFORM="wayland;xcb" python3 /usr/bin/caelaris-installer-gui "$@"
        exit $?
    fi
fi

# 5. Launch with root privileges via sudo
if [ -x /usr/bin/caelaris-installer-gui ] || [ -f /usr/bin/caelaris-installer-gui ]; then
    echo "[*] Launching installer with root privileges (XCB / XWayland)..."
    sudo -E env DISPLAY="$DISPLAY" \
                 XAUTHORITY="$XAUTHORITY" \
                 QT_QPA_PLATFORM="xcb" \
                 python3 /usr/bin/caelaris-installer-gui "$@"
    STATUS=$?
    if [ $STATUS -eq 0 ]; then
        exit 0
    fi

    echo "[!] XCB launch exited with code $STATUS. Retrying with Wayland backend..."
    sudo -E env DISPLAY="$DISPLAY" \
                 WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
                 XDG_RUNTIME_DIR="$USER_RUNTIME" \
                 XAUTHORITY="$XAUTHORITY" \
                 QT_QPA_PLATFORM="wayland;xcb" \
                 python3 /usr/bin/caelaris-installer-gui "$@"
    STATUS=$?
    if [ $STATUS -eq 0 ]; then
        exit 0
    fi

    echo "[!] Sudo failed ($STATUS). Trying pkexec..."
    pkexec env DISPLAY="$DISPLAY" \
               XAUTHORITY="$XAUTHORITY" \
               QT_QPA_PLATFORM="xcb" \
               python3 /usr/bin/caelaris-installer-gui "$@"
    STATUS=$?
    if [ $STATUS -eq 0 ]; then
        exit 0
    fi
fi

# 6. If GUI failed, open a visible terminal so the user sees diagnostics
echo "[-] Graphical installer failed to launch with administrative privileges."
if command -v konsole >/dev/null 2>&1; then
    exec konsole -e /bin/bash -c "echo '=== Caelaris Installer Privilege Error ==='; cat '$LOGFILE'; echo ''; read -p 'Press Enter to close...'"
elif command -v ptyxis >/dev/null 2>&1; then
    exec ptyxis -- /bin/bash -c "echo '=== Caelaris Installer Privilege Error ==='; cat '$LOGFILE'; echo ''; read -p 'Press Enter to close...'"
fi
