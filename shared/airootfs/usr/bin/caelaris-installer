#!/usr/bin/env bash
# Caelaris Linux Guided System Installer Wrapper
clear
cat << "EOF"
  ==============================================================
                    Caelaris Linux Installer                    
  ==============================================================
  Welcome to the Caelaris Linux guided installation wizard.
  This tool will guide you through:
    1. Region, Language & Keyboard Selection
    2. Disk Partitioning (Btrfs / Ext4)
    3. User Account & Password Configuration
    4. Desktop Selection (KDE Plasma or GNOME)
    5. Third-Party Software & Driver Installation
  ==============================================================

EOF

echo "Launching installer..."
sleep 1
sudo archinstall
ret=$?

if [ $ret -eq 0 ]; then
    echo
    echo "Installation completed successfully! You can now reboot into Caelaris Linux."
else
    echo
    echo "Installation exited or cancelled."
fi
echo "Press Enter to exit..."
read
