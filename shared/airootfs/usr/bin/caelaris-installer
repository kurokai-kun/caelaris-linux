#!/usr/bin/env bash
# Caelaris Linux System Installer Launcher
set +e

LOGFILE="/tmp/caelaris-installer.log"

# Step 1: If launched as normal unprivileged user, configure display authorizations and elevate to root
if [ "$(id -u)" -ne 0 ]; then
    USER_UID="$(id -u)"
    USER_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/${USER_UID}}"

    # 1. Authorize root on X11 / XWayland via xhost
    if command -v xhost >/dev/null 2>&1; then
        xhost +SI:localuser:root 2>/dev/null || true
        xhost +local:root 2>/dev/null || true
        xhost + 2>/dev/null || true
    fi

    # 2. Extract and merge current X11 authority cookie to root
    if [ -n "$DISPLAY" ] && command -v xauth >/dev/null 2>&1; then
        xauth extract - "$DISPLAY" 2>/dev/null | sudo xauth merge - 2>/dev/null || true
    fi

    # 3. Setup root Wayland runtime directory and bridge socket using sudo
    sudo mkdir -p /run/user/0 2>/dev/null || true
    sudo chmod 700 /run/user/0 2>/dev/null || true
    sudo chown root:root /run/user/0 2>/dev/null || true

    if [ -d "$USER_RUNTIME" ]; then
        chmod 777 "$USER_RUNTIME" 2>/dev/null || true
        for sock in "$USER_RUNTIME"/wayland-*; do
            if [ -e "$sock" ]; then
                chmod 777 "$sock" 2>/dev/null || true
                base="$(basename "$sock")"
                sudo ln -sf "$sock" "/run/user/0/$base" 2>/dev/null || true
            fi
        done
    fi

    # 4. Copy XAUTHORITY to root
    XAUTH_SRC="${XAUTHORITY}"
    if [ -z "$XAUTH_SRC" ] || [ ! -f "$XAUTH_SRC" ]; then
        for f in "$USER_RUNTIME"/xauth_* "$HOME"/.Xauthority /tmp/xauth_*; do
            if [ -f "$f" ]; then
                XAUTH_SRC="$f"
                break
            fi
        done
    fi
    if [ -n "$XAUTH_SRC" ] && [ -f "$XAUTH_SRC" ]; then
        sudo cp -f "$XAUTH_SRC" /root/.Xauthority 2>/dev/null || true
        sudo chmod 600 /root/.Xauthority 2>/dev/null || true
    fi

    # Re-exec as root preserving display environment
    exec sudo -E env DISPLAY="${DISPLAY:-:0}" \
                     WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
                     XDG_RUNTIME_DIR="/run/user/0" \
                     XAUTHORITY="/root/.Xauthority" \
                     /usr/bin/caelaris-installer "$@"
fi

# Step 2: Running as root - Log environment
{
    echo "=============================================="
    echo " Starting Caelaris Linux Installer (Root)      "
    echo "=============================================="
    echo "[*] Date: $(date)"
    echo "[*] User: $(whoami) (UID: $(id -u))"
    echo "[*] DISPLAY: ${DISPLAY:-none}"
    echo "[*] WAYLAND_DISPLAY: ${WAYLAND_DISPLAY:-none}"
    echo "[*] XDG_RUNTIME_DIR: ${XDG_RUNTIME_DIR:-none}"
} > "$LOGFILE"

export DISPLAY="${DISPLAY:-:0}"
export PYTHONUNBUFFERED=1

# Attempt 1: Direct XCB via XWayland / X11 (most compatible for root GUI on desktop)
env QT_QPA_PLATFORM="xcb" python3 -u /usr/bin/caelaris-installer-gui "$@" >> "$LOGFILE" 2>&1
STATUS=$?
if [ $STATUS -eq 0 ] || [ $STATUS -eq 130 ]; then
    exit 0
fi

# Attempt 2: Native Wayland with XCB fallback
if [ -n "$WAYLAND_DISPLAY" ] && [ -e "/run/user/0/$WAYLAND_DISPLAY" ]; then
    env QT_QPA_PLATFORM="wayland;xcb" python3 -u /usr/bin/caelaris-installer-gui "$@" >> "$LOGFILE" 2>&1
    STATUS=$?
    if [ $STATUS -eq 0 ] || [ $STATUS -eq 130 ]; then
        exit 0
    fi
fi

# Attempt 3: Direct Wayland
if [ -n "$WAYLAND_DISPLAY" ] && [ -e "/run/user/0/$WAYLAND_DISPLAY" ]; then
    env QT_QPA_PLATFORM="wayland" python3 -u /usr/bin/caelaris-installer-gui "$@" >> "$LOGFILE" 2>&1
    STATUS=$?
    if [ $STATUS -eq 0 ] || [ $STATUS -eq 130 ]; then
        exit 0
    fi
fi

# Only display diagnostic if all graphical launch attempts failed
echo "[-] Graphical installer failed to launch (exit code: $STATUS)." >> "$LOGFILE"
sync
if command -v konsole >/dev/null 2>&1; then
    exec konsole -e /bin/bash -c "echo '=== Caelaris Installer Launch Diagnostic ==='; cat '$LOGFILE'; echo ''; read -p 'Press Enter to close...'"
elif command -v ptyxis >/dev/null 2>&1; then
    exec ptyxis -- /bin/bash -c "echo '=== Caelaris Installer Launch Diagnostic ==='; cat '$LOGFILE'; echo ''; read -p 'Press Enter to close...'"
fi
