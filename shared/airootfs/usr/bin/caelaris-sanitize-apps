#!/usr/bin/env bash
# ==============================================================================
# Caelaris Linux Desktop Application Separation & Sanitation
# Enforces strict isolation across the Tri-Desktop environments:
#   - KDE Plasma 6: Only KDE apps + Universal (Firefox, VLC, Steam, Update)
#   - GNOME 4x: Only GNOME apps + Universal (Zero KDE apps, Zero duplicate apps)
#   - Caelestia Shell: Dynamic tiling suite + Universal (Zero GNOME duplicates)
# And purges developer, daemon, and subsystem clutter icons from all environments.
# ==============================================================================
set -e

TARGET_PREFIX="${1:-}"
if [ -n "$TARGET_PREFIX" ] && [ "$TARGET_PREFIX" != "/" ]; then
    TARGET_PREFIX="${TARGET_PREFIX%/}"
fi

APP_DIRS=(
    "${TARGET_PREFIX}/usr/share/applications"
    "${TARGET_PREFIX}/usr/local/share/applications"
)

# ── 1. Developer, Daemon, & Subsystem Clutter -> Globally Hide (NoDisplay=true) ─
CLUTTER_APPS=(
    # Developer tools, debug benches & widget factories
    avahi-discover bssh bvnc qv4l2 qvidcap lstopo cmake-gui
    electron electron31 electron32 electron33
    vim nvim vi nano htop btop nvtop
    archinstall caelaris-autoresize
    gtk3-icon-browser gtk4-icon-browser gtk3-widget-factory gtk4-widget-factory
    yad-icon-browser designer linguist assistant qdbusviewer qdbusviewer6
    # Subsystem & daemon launchers
    cups print-manager system-config-printer
    gcr-viewer gcr-prompter geoclue-where-am-i
    rygel rygel-preferences
    nm-connection-editor pavucontrol
    # GNOME Clutter / Redundant Builtins
    org.gnome.Tour org.gnome.Characters org.gnome.font-viewer org.gnome.Logs
    # KDE Clutter / Redundant Subsystem Launchers
    org.kde.kfind org.kde.plasma.emojier org.kde.plasma.vault org.kde.plasma.vault-desktopenv
    org.kde.knetattach org.kde.drkonqi org.kde.ksshaskpass org.kde.polkit-kde-authentication-agent-1
    kcm_networkmanagement kcm_firewall kcm_disks
)

# ── 2. KDE-Exclusive Apps -> Hidden in GNOME (NotShowIn=GNOME;) ───────────────────
KDE_EXCLUSIVE_APPS=(
    org.kde.dolphin dolphin
    org.kde.konsole konsole
    org.kde.kate kate
    org.kde.kwrite kwrite
    org.kde.ark ark
    org.kde.spectacle spectacle
    org.kde.gwenview gwenview
    org.kde.kcalc kcalc
    org.kde.plasma-systemmonitor plasma-systemmonitor
    systemsettings kinfocenter
    org.kde.discover discover
    org.kde.kwalletmanager5 kwalletmanager5
    org.kde.plasma-welcome
    org.kde.okular okular
    org.kde.haruna haruna
    org.kde.elisa elisa
)

# ── 3. GNOME-Exclusive Apps -> Only in GNOME (OnlyShowIn=GNOME;) ─────────────────
GNOME_EXCLUSIVE_APPS=(
    org.gnome.Nautilus nautilus
    org.gnome.Ptyxis ptyxis
    org.gnome.TextEditor gnome-text-editor
    org.gnome.Calculator gnome-calculator
    org.gnome.SystemMonitor gnome-system-monitor
    org.gnome.DiskUtility gnome-disk-utility
    gnome-control-center org.gnome.Settings
    org.gnome.Console org.gnome.Terminal
    org.gnome.Software
    org.gnome.Evince evince
    org.gnome.FileRoller file-roller
    org.gnome.Loupe loupe
    org.gnome.Snapshot snapshot
    org.gnome.Totem totem
    org.gnome.baobab baobab
    org.gnome.Music org.gnome.Photos org.gnome.Contacts org.gnome.Weather org.gnome.Clocks org.gnome.Maps
)

echo "==> Sanitizing desktop application menus across all environments..."

for dir in "${APP_DIRS[@]}"; do
    [ -d "$dir" ] || continue

    # A. Process Clutter Apps (Globally Hide)
    for app in "${CLUTTER_APPS[@]}"; do
        df="${dir}/${app}.desktop"
        if [ -f "$df" ]; then
            sed -i '/^NoDisplay=/d' "$df" 2>/dev/null || true
            echo "NoDisplay=true" >> "$df"
        fi
    done

    # B. Process KDE Exclusive Apps (Hide from GNOME)
    for app in "${KDE_EXCLUSIVE_APPS[@]}"; do
        df="${dir}/${app}.desktop"
        if [ -f "$df" ]; then
            sed -i '/^NotShowIn=/d; /^OnlyShowIn=/d' "$df" 2>/dev/null || true
            echo "NotShowIn=GNOME;" >> "$df"
        fi
    done

    # C. Process GNOME Exclusive Apps (Show only in GNOME, hiding from KDE & Caelestia Shell)
    for app in "${GNOME_EXCLUSIVE_APPS[@]}"; do
        df="${dir}/${app}.desktop"
        if [ -f "$df" ]; then
            sed -i '/^NotShowIn=/d; /^OnlyShowIn=/d' "$df" 2>/dev/null || true
            echo "OnlyShowIn=GNOME;" >> "$df"
        fi
    done
done

# Remove raw terminal text editor launcher files
rm -f "${TARGET_PREFIX}/usr/share/applications/vim.desktop" \
      "${TARGET_PREFIX}/usr/share/applications/nvim.desktop" 2>/dev/null || true

# Remove any legacy switch-desktop launcher shortcuts
rm -f "${TARGET_PREFIX}/usr/share/applications/switch-desktop.desktop" \
      "${TARGET_PREFIX}/usr/share/applications/caelaris-switch-desktop.desktop" 2>/dev/null || true

# Clean Desktop Policy: Ensure no icons or software exist in advance
mkdir -p "${TARGET_PREFIX}/etc/skel/Desktop"
rm -rf "${TARGET_PREFIX}/etc/skel/Desktop"/* 2>/dev/null || true

# If executing on installed system, remove installer & switch-desktop shortcuts from user desktops
if [ -z "$TARGET_PREFIX" ] || [ "$TARGET_PREFIX" = "/" ]; then
    if [ ! -d /run/archiso ]; then
        for udir in /home/*; do
            if [ -d "$udir/Desktop" ]; then
                rm -f "$udir/Desktop/install-caelaris.desktop" \
                      "$udir/Desktop/caelaris-installer"*.desktop \
                      "$udir/Desktop/switch-desktop.desktop" \
                      "$udir/Desktop/switch-"*.desktop 2>/dev/null || true
            fi
        done
    fi
fi

# Rebuild desktop database and icon caches if executing on live or running system
if [ -z "$TARGET_PREFIX" ] || [ "$TARGET_PREFIX" = "/" ]; then
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications 2>/dev/null || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi
    if command -v kbuildsycoca6 >/dev/null 2>&1; then
        kbuildsycoca6 --noincremental 2>/dev/null || true
    fi
else
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "${TARGET_PREFIX}/usr/share/applications" 2>/dev/null || true
    fi
fi

echo "==> Desktop application separation complete! All 3 environments are clean and isolated."
