#!/usr/bin/env bash
# ==========================================================
# Caelestia Shell Autostart Supervisor
# Reliably manages daemons, wallpaper, and Waybar
# ==========================================================
set +e

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# 1. Ensure Wayland display socket is ready
for i in {1..30}; do
    if [ -n "$WAYLAND_DISPLAY" ]; then
        if [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ] || [ -S "$XDG_RUNTIME_DIR/wayland-0" ] || [ -S "$XDG_RUNTIME_DIR/wayland-1" ]; then
            break
        fi
    fi
    sleep 0.1
done

# 2. Register display environment with D-Bus and systemd user session
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null || true
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP HYPRLAND_INSTANCE_SIGNATURE 2>/dev/null || true

# 3. Audio & Polkit User Services
systemctl --user start pipewire pipewire-pulse wireplumber 2>/dev/null || true

if [ -x /usr/lib/polkit-kde-authentication-agent-1 ]; then
    /usr/lib/polkit-kde-authentication-agent-1 &
elif [ -x /usr/libexec/polkit-kde-authentication-agent-1 ]; then
    /usr/libexec/polkit-kde-authentication-agent-1 &
fi

# 4. Network system tray applet
command -v nm-applet >/dev/null 2>&1 && (nm-applet --indicator &)

# 5. Set Caelestia Wallpaper (Official Anime Wallpaper with Fallback)
WALLPAPER="/usr/share/backgrounds/caelestia-wallpaper.jpg"
[ ! -f "$WALLPAPER" ] && WALLPAPER="/usr/share/backgrounds/caelaris-wallpaper.jpg"
[ ! -f "$WALLPAPER" ] && WALLPAPER="/usr/share/pixmaps/caelaris-logo.png"

killall swaybg 2>/dev/null || true
if command -v swaybg >/dev/null 2>&1 && [ -f "$WALLPAPER" ]; then
    swaybg -m fill -i "$WALLPAPER" &
elif command -v hyprpaper >/dev/null 2>&1; then
    hyprpaper &
fi

# 6. Notification Daemon (Dunst / Mako)
if command -v dunst >/dev/null 2>&1; then
    killall dunst 2>/dev/null || true
    dunst &
elif command -v mako >/dev/null 2>&1; then
    killall mako 2>/dev/null || true
    mako &
fi

# 7. Waybar / Caelestia Top Bar
killall waybar 2>/dev/null || true
if [ -f /etc/caelestia/waybar/config.jsonc ]; then
    waybar -c /etc/caelestia/waybar/config.jsonc -s /etc/caelestia/waybar/style.css &
elif command -v waybar >/dev/null 2>&1; then
    waybar &
fi

# 8. Visual confirmation banner
(
    sleep 1
    notify-send -u normal "Caelestia Shell" "Press Super+Space for App Launcher" -i /usr/share/pixmaps/caelaris-logo.png 2>/dev/null || true
) &


