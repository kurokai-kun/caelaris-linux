        v_desc.setStyleSheet("font-size: 12px; color: #475569; line-height: 1.4;")
        v_layout.addWidget(v_desc)

        v_specs = QLabel(f"Hardware VRAM: {get_vram_info()} • Protection Engine: dmemcg-booster & caelaris-vram-booster")
        v_specs.setStyleSheet("font-size: 11px; font-weight: 600; color: #6366f1;")
        v_layout.addWidget(v_specs)

        layout.addWidget(vram_card)

        card = QFrame()
        card.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Minimum)
        card.setStyleSheet("background: #ffffff; border: 1px solid #e4dbd1; border-radius: 20px; padding: 20px;")
        c_layout = QVBoxLayout(card)
        c_layout.setSpacing(14)

        perf_items = [
            ("ZRAM Memory Engine", "zstd compressed in-memory swap enabled (High throughput, no disk thrashing)"),
            ("Gaming Memory Limits", "vm.max_map_count=2147483642 (DirectX 12 & Unreal Engine 5 certified)"),
            ("Process Priority Scheduler", "Real-Time Kit (rtkit) active for audio and Wayland compositor threads"),
            ("Graphics Driver Subsystem", "Mesa Direct Rendering & Vulkan with ACO shader pre-caching"),
        ]
        for k, v in perf_items:
            row = QVBoxLayout()
            row.setSpacing(2)
            k_lbl = QLabel(f"⚡ {k}")
            k_lbl.setStyleSheet("font-size: 13px; font-weight: 800; color: #d97706;")
            v_lbl = QLabel(v)
            v_lbl.setWordWrap(True)
            v_lbl.setStyleSheet("font-size: 12px; color: #6d6157;")
            row.addWidget(k_lbl)
            row.addWidget(v_lbl)
            c_layout.addLayout(row)

        layout.addWidget(card)

        btn_mon = QPushButton("📊 Launch System Monitor")
        btn_mon.setStyleSheet("background: #d97706; color: white; padding: 12px 22px; border-radius: 14px; font-weight: 700; border: none;")
        btn_mon.setCursor(Qt.CursorShape.PointingHandCursor)
        btn_mon.clicked.connect(lambda: os.system("plasma-systemmonitor || gnome-system-monitor || mission-center &"))
        layout.addWidget(btn_mon, alignment=Qt.AlignmentFlag.AlignLeft)

        layout.addStretch()
        return page

    def check_updates(self):
        self.btn_check_up.setEnabled(False)
        self.lbl_u_status.setText("Checking official Arch Linux repositories...")
        self.check_worker = CheckUpdatesWorker()
        self.check_worker.result_signal.connect(self.on_check_finished)
        self.check_worker.start()

    def on_check_finished(self, count, packages):
        self.btn_check_up.setEnabled(True)
        if count == 0:
            self.lbl_u_status.setText("✓ Your Caelaris Linux system is fully up to date! (0 pending updates)")
            self.lbl_u_status.setStyleSheet("font-size: 12px; font-weight: 700; color: #2e7d32;")
        else:
            self.lbl_u_status.setText(f"⚡ {count} verified updates are available for your system.")
            self.lbl_u_status.setStyleSheet("font-size: 12px; font-weight: 700; color: #d97706;")

    def run_os_update(self):
        self.btn_run_up.setEnabled(False)
        self.btn_check_up.setEnabled(False)
        self.update_progress.setVisible(True)
        self.update_progress.setValue(5)
        self.lbl_u_status.setText("Starting live OS upgrade...")

        self.up_worker = UpdateWorker()
        self.up_worker.step_signal.connect(self.on_update_step)
        self.up_worker.finished_signal.connect(self.on_update_complete)
        self.up_worker.start()

    def on_update_step(self, pct, message):
        self.update_progress.setValue(pct)
        self.lbl_u_status.setText(message)

    def on_update_complete(self, success, message):
        self.btn_run_up.setEnabled(True)
        self.btn_check_up.setEnabled(True)
        self.lbl_u_status.setText(message)
        if success:
            QMessageBox.information(self, "Caelaris System Update", message)
        else:
            QMessageBox.warning(self, "Update Alert", message)

def main():
    app = QApplication(sys.argv)
    window = CaelarisAbout()
    window.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
