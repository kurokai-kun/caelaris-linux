def get_cpu_info():
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if "model name" in line:
                    model = line.split(":", 1)[1].strip()
                    cores = os.cpu_count() or 1
                    return f"{model} ({cores} Cores)"
    except Exception:
        pass
    return f"{platform.processor() or 'Generic x86_64 / ARM64'} ({os.cpu_count()} Cores)"

def get_ram_info():
    try:
        with open("/proc/meminfo", "r") as f:
            lines = f.readlines()
            total_kb = int(lines[0].split()[1])
            avail_kb = int(lines[2].split()[1])
            total_gb = total_kb / (1024 * 1024)
            used_gb = (total_kb - avail_kb) / (1024 * 1024)
            return f"{total_gb:.1f} GiB Total ({used_gb:.1f} GiB In Use)"
    except Exception:
        pass
    return "Unknown RAM"

def get_gpu_info():
    try:
        res = subprocess.run(["lspci"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        gpus = []
        for line in res.stdout.splitlines():
            if "VGA" in line or "3D" in line or "Display" in line:
                parts = line.split(":", 2)
                if len(parts) >= 3:
                    gpu_name = parts[2].strip()
                    gpu_name = re.sub(r'\(rev \w+\)', '', gpu_name).strip()
                    gpus.append(gpu_name)
        if gpus:
            return " / ".join(gpus)
    except Exception:
        pass

    try:
        res = subprocess.run(["glxinfo", "-B"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        for line in res.stdout.splitlines():
            if "Device:" in line:
                return line.split(":", 1)[1].strip()
    except Exception:
        pass

    return "Standard Accelerated Graphics (Mesa Gallium / Wayland)"

def get_vram_info():
    try:
        from pathlib import Path
        max_bytes = 0
        for card in Path("/sys/class/drm").glob("card[0-9]*"):
            v_file = card / "device" / "mem_info_vram_total"
            if v_file.exists():
                v = int(v_file.read_text().strip())
                if v > max_bytes:
                    max_bytes = v
            for lmem in (card / "device").glob("**/physical_vram_size"):
                v = int(lmem.read_text().strip())
                if v > max_bytes:
                    max_bytes = v
        if max_bytes > 0:
            return f"{max_bytes / (1024**3):.1f} GiB Dedicated VRAM"
    except Exception:
        pass
    return "Dedicated / Shared VRAM"

def get_storage_info():
    try:
        usage = shutil.disk_usage("/")
        total_gb = usage.total / (1024 ** 3)
        free_gb = usage.free / (1024 ** 3)
        used_gb = usage.used / (1024 ** 3)
        
        fstype = "Btrfs"
        try:
            res = subprocess.run(["findmnt", "-n", "-o", "FSTYPE", "/"], stdout=subprocess.PIPE, text=True)
            if res.stdout.strip():
                fstype = res.stdout.strip().upper()
        except Exception:
            pass

        return f"{total_gb:.1f} GB ({free_gb:.1f} GB Free, {used_gb:.1f} GB Used) • {fstype}"
    except Exception:
        return "Local Storage Partition"

def get_motherboard_info():
    vendor = ""
    name = ""
    try:
        if os.path.isfile("/sys/class/dmi/id/sys_vendor"):
            with open("/sys/class/dmi/id/sys_vendor", "r") as f:
                vendor = f.read().strip()
        if os.path.isfile("/sys/class/dmi/id/product_name"):
            with open("/sys/class/dmi/id/product_name", "r") as f:
                name = f.read().strip()
        if vendor or name:
            return f"{vendor} {name}".strip()
    except Exception:
        pass

    try:
        if os.path.isfile("/proc/device-tree/model"):
            with open("/proc/device-tree/model", "r") as f:
                return f.read().strip()
    except Exception:
        pass

    return "PC Compatible System / Virtual Platform"

def get_desktop_info():
    de = os.environ.get("XDG_CURRENT_DESKTOP", "")
    if not de:
        de = os.environ.get("DESKTOP_SESSION", "")
    
    de_lower = de.lower()
    if "plasma" in de_lower or "kde" in de_lower:
        return "KDE Plasma 6 (Wayland)"
    elif "gnome" in de_lower:
        return "GNOME 4x (Wayland)"
    elif "hyprland" in de_lower or "caelestia" in de_lower:
        return "Caelestia Shell (Hyprland Dynamic Tiling)"
    return de or "Wayland Desktop Session"

class UpdateWorker(QThread):
    step_signal = pyqtSignal(int, str)
    finished_signal = pyqtSignal(bool, str)

    def run(self):
        try:
            self.step_signal.emit(15, "Synchronizing official Arch Linux cryptographic repositories...")
            subprocess.run(["pkexec", "pacman", "-Sy", "--noconfirm"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            self.step_signal.emit(35, "Checking package integrity & security advisories...")
            res_check = subprocess.run(["pacman", "-Qu"], stdout=subprocess.PIPE, text=True)
            updates = [l for l in res_check.stdout.splitlines() if l.strip()]

            if not updates:
                self.step_signal.emit(70, "Checking verified Flathub application updates...")
                subprocess.run(["flatpak", "update", "-y", "--noninteractive"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.step_signal.emit(100, "Your system is fully up-to-date! No pending updates.")
                self.finished_signal.emit(True, "Your Caelaris Linux system is running the latest verified packages.")
                return

            self.step_signal.emit(55, f"Downloading and applying {len(updates)} verified package updates...")
            subprocess.run(["pkexec", "pacman", "-Su", "--noconfirm"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

            self.step_signal.emit(75, "Updating verified Flathub application runtimes...")
            subprocess.run(["flatpak", "update", "-y", "--noninteractive"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            self.step_signal.emit(90, "Refreshing font caches and desktop databases...")
            subprocess.run(["fc-cache", "-r"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["update-desktop-database", "/usr/share/applications"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            self.step_signal.emit(100, "Update completed successfully!")
            self.finished_signal.emit(True, f"Successfully installed {len(updates)} verified updates.")
        except Exception as e:
            self.finished_signal.emit(False, f"Update process encountered an error: {str(e)}")

class CheckUpdatesWorker(QThread):
    result_signal = pyqtSignal(int, list)

    def run(self):
        try:
            subprocess.run(["pacman", "-Sy"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            res = subprocess.run(["pacman", "-Qu"], stdout=subprocess.PIPE, text=True)
            packages = [l.split()[0] for l in res.stdout.splitlines() if l.strip()]
            self.result_signal.emit(len(packages), packages)
        except Exception:
            self.result_signal.emit(0, [])

