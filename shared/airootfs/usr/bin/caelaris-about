    def check_updates(self):
        self.lbl_u_status.setText("Checking official cryptographic package mirrors...")
        self.btn_check_up.setEnabled(False)
        self.checker = CheckUpdatesWorker()
        self.checker.result_signal.connect(self.on_check_finished)
        self.checker.start()

    def on_check_finished(self, count, packages):
        self.btn_check_up.setEnabled(True)
        if count == 0:
            self.lbl_u_status.setText("✓ Your Caelaris Linux system is fully up to date! (0 pending updates)")
            QMessageBox.information(self, "System Up to Date", "All packages and kernel components are running the latest verified release.")
        else:
            sample = ", ".join(packages[:4])
            if count > 4:
                sample += f" and {count - 4} others"
            self.lbl_u_status.setText(f"Updates available: {count} verified package(s) ({sample})")

    def run_os_update(self):
        self.btn_run_up.setEnabled(False)
        self.btn_check_up.setEnabled(False)
        self.update_progress.setVisible(True)
        self.update_progress.setValue(10)
        self.lbl_u_status.setText("Starting verified operating system update...")

        self.up_worker = UpdateWorker()
        self.up_worker.step_signal.connect(self.on_update_step)
        self.up_worker.finished_signal.connect(self.on_update_completed)
        self.up_worker.start()

    def on_update_step(self, pct, message):
        self.update_progress.setValue(pct)
        self.lbl_u_status.setText(message)

    def on_update_completed(self, success, message):
        self.btn_run_up.setEnabled(True)
        self.btn_check_up.setEnabled(True)
        self.update_progress.setValue(100)
        self.lbl_u_status.setText(message)
        if success:
            QMessageBox.information(self, "OS Update Complete", message)
        else:
            QMessageBox.warning(self, "Update Notice", message)

def main():
    app = QApplication(sys.argv)
    window = CaelarisAbout()
    window.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
