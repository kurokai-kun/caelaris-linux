    def create_nav_btn(self, text, page_idx, active=False):
        btn = QPushButton(text)
        btn.setStyleSheet(f"""
            QPushButton {{
                text-align: left;
                padding: 10px 14px;
                border-radius: 12px;
                font-size: 13px;
                font-weight: {'800' if active else '600'};
                color: {'#0284c7' if active else '#5a4f46'};
                background: {'rgba(2, 132, 199, 0.12)' if active else 'transparent'};
                border: none;
            }}
            QPushButton:hover {{
                background: rgba(2, 132, 199, 0.12);
                color: #0284c7;
            }}
        """)
        btn.setCursor(Qt.CursorShape.PointingHandCursor)
        btn.clicked.connect(lambda: self.switch_page(btn, page_idx))
        return btn

    def switch_page(self, btn, page_idx):
        self.content_stack.setCurrentIndex(page_idx)
        for b in [self.btn_about, self.btn_security, self.btn_perf]:
            if b == btn:
                b.setStyleSheet("""
                    QPushButton {
                        text-align: left;
                        padding: 10px 14px;
                        border-radius: 12px;
                        font-size: 13px;
                        font-weight: 800;
                        color: #0284c7;
                        background: rgba(2, 132, 199, 0.12);
                        border: none;
                    }
                """)
            else:
                b.setStyleSheet("""
                    QPushButton {
                        text-align: left;
                        padding: 10px 14px;
                        border-radius: 12px;
                        font-size: 13px;
                        font-weight: 600;
                        color: #5a4f46;
                        background: transparent;
                        border: none;
                    }
                    QPushButton:hover {
                        background: rgba(2, 132, 199, 0.12);
                        color: #0284c7;
                    }
                """)

