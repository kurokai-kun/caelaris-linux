    def create_spec_card(self, title, items):
        card = QFrame()
        card.setStyleSheet("background: #ffffff; border: 1px solid #e4dbd1; border-radius: 20px; padding: 18px;")
        layout = QVBoxLayout(card)
        layout.setSpacing(12)

        lbl_t = QLabel(title)
        lbl_t.setStyleSheet("font-size: 15px; font-weight: 800; color: #2d2621; margin-bottom: 4px;")
        layout.addWidget(lbl_t)

        for key, val in items:
            row = QVBoxLayout()
            row.setSpacing(2)
            k_lbl = QLabel(key)
            k_lbl.setStyleSheet("font-size: 11px; font-weight: 700; color: #7d7065;")
            v_lbl = QLabel(val)
            v_lbl.setWordWrap(True)
            v_lbl.setStyleSheet("font-size: 12px; font-weight: 600; color: #2d2621;")
            row.addWidget(k_lbl)
            row.addWidget(v_lbl)
            layout.addLayout(row)

        layout.addStretch()
        return card

