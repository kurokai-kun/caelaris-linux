#!/usr/bin/env bash
# ==========================================================
# Caelaris Desktop Hot Switcher
# Seamlessly switch between KDE Plasma 6, GNOME, and Caelestia Shell (Hyprland)
# ==========================================================
set -e

# Re-elevate with sudo if not root
if [ "$(id -u)" -ne 0 ]; then
    if command -v pkexec >/dev/null 2>&1 && [ -z "$SUDO_COMMAND" ]; then
        exec pkexec env DISPLAY="$DISPLAY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" "$0" "$@"
    else
        exec sudo env DISPLAY="$DISPLAY" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" "$0" "$@"
    fi
fi

TARGET="$1"
TARGET_USER="${SUDO_USER:-$USER}"
[ "$TARGET_USER" = "root" ] && TARGET_USER="liveuser"

# Detect current session
CURRENT="plasma"
if [ -f "/var/lib/AccountsService/users/$TARGET_USER" ]; then
    CURRENT=$(grep -oP '(?<=Session=).*' "/var/lib/AccountsService/users/$TARGET_USER" 2>/dev/null || echo "plasma")
elif [ -f /etc/sddm.conf.d/autologin.conf ]; then
    CURRENT=$(grep -oP '(?<=Session=).*' /etc/sddm.conf.d/autologin.conf 2>/dev/null || echo "plasma")
fi

# Normalize current
case "$CURRENT" in
    *caelestia*|*hyprland*) CURRENT="hyprland" ;;
    *gnome*) CURRENT="gnome" ;;
    *) CURRENT="plasma" ;;
esac

# Interactive picker if TARGET not specified
if [ -z "$TARGET" ]; then
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        # Try Python PyQt6 GUI modal first for native aesthetic
        if command -v python3 >/dev/null 2>&1 && python3 -c "import PyQt6" >/dev/null 2>&1; then
            TARGET=$(python3 - << 'PYEOF'
import sys
from PyQt6.QtWidgets import (QApplication, QDialog, QVBoxLayout, QHBoxLayout,
                             QLabel, QPushButton, QRadioButton, QButtonGroup, QFrame)
from PyQt6.QtCore import Qt

app = QApplication(sys.argv)
dlg = QDialog()
dlg.setWindowTitle("Caelaris Desktop Hot Switcher")
dlg.setFixedSize(500, 340)
dlg.setStyleSheet("""
    QDialog { background-color: #0f172a; color: #f8fafc; font-family: 'Noto Sans', sans-serif; }
    QLabel#title { font-size: 18px; font-weight: bold; color: #38bdf8; }
    QLabel#subtitle { font-size: 12px; color: #94a3b8; }
    QFrame#card { background: rgba(30, 41, 59, 0.7); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 14px; }
    QRadioButton { font-size: 13px; font-weight: 500; color: #f1f5f9; padding: 6px; }
    QRadioButton::indicator { width: 18px; height: 18px; border-radius: 9px; border: 2px solid #64748b; background: #1e293b; }
    QRadioButton::indicator:checked { border-color: #38bdf8; background: #38bdf8; }
    QPushButton#btnSwitch { background-color: #0284c7; color: white; font-weight: bold; border-radius: 6px; padding: 8px 18px; }
    QPushButton#btnSwitch:hover { background-color: #38bdf8; color: #0f172a; }
    QPushButton#btnCancel { background-color: #334155; color: #e2e8f0; border-radius: 6px; padding: 8px 18px; }
    QPushButton#btnCancel:hover { background-color: #475569; }
""")

layout = QVBoxLayout(dlg)
layout.setContentsMargins(20, 20, 20, 20)
layout.setSpacing(12)

lbl_title = QLabel("✦ Switch Desktop Environment", objectName="title")
lbl_sub = QLabel("Select an interface to load. The display manager will reload instantly.", objectName="subtitle")
layout.addWidget(lbl_title)
layout.addWidget(lbl_sub)

card = QFrame(objectName="card")
card_l = QVBoxLayout(card)
bg = QButtonGroup(dlg)

rb1 = QRadioButton("KDE Plasma 6 (Feature-rich, customizable)")
rb2 = QRadioButton("GNOME Desktop (Clean, elegant, distraction-free)")
rb3 = QRadioButton("Caelestia Shell (Hyprland animated dynamic tiling)")

bg.addButton(rb1, 1)
bg.addButton(rb2, 2)
bg.addButton(rb3, 3)

rb1.setChecked(True)
card_l.addWidget(rb1)
card_l.addWidget(rb2)
card_l.addWidget(rb3)
layout.addWidget(card)

btn_bar = QHBoxLayout()
btn_cancel = QPushButton("Cancel", objectName="btnCancel")
btn_cancel.clicked.connect(dlg.reject)
btn_switch = QPushButton("Switch Now 🚀", objectName="btnSwitch")
btn_switch.clicked.connect(dlg.accept)
btn_bar.addStretch()
btn_bar.addWidget(btn_cancel)
btn_bar.addWidget(btn_switch)
layout.addLayout(btn_bar)

if dlg.exec() == QDialog.DialogCode.Accepted:
    sel = bg.checkedId()
    if sel == 1:
        print("plasma")
    elif sel == 2:
        print("gnome")
    elif sel == 3:
        print("hyprland")
PYEOF
            )
        elif command -v zenity >/dev/null 2>&1; then
            TARGET=$(zenity --list --radiolist \
                --title="Caelaris Hot Switcher" \
                --text="Select Desktop Environment to switch to:" \
                --column="Pick" --column="Session" --column="Description" \
                $([ "$CURRENT" = "plasma" ] && echo "TRUE" || echo "FALSE") "plasma" "KDE Plasma 6 (Modern, customizable)" \
                $([ "$CURRENT" = "gnome" ] && echo "TRUE" || echo "FALSE") "gnome" "GNOME Desktop (Clean, elegant)" \
                $([ "$CURRENT" = "hyprland" ] && echo "TRUE" || echo "FALSE") "hyprland" "Caelestia Shell (Hyprland - Fluid tiling Wayland)" \
                --width=520 --height=260 2>/dev/null || true)
        elif command -v kdialog >/dev/null 2>&1; then
            TARGET=$(kdialog --radiolist "Select Desktop Environment to switch to:" \
                "plasma" "KDE Plasma 6" $([ "$CURRENT" = "plasma" ] && echo "on" || echo "off") \
                "gnome" "GNOME Desktop" $([ "$CURRENT" = "gnome" ] && echo "on" || echo "off") \
                "hyprland" "Caelestia Shell (Hyprland)" $([ "$CURRENT" = "hyprland" ] && echo "on" || echo "off") \
                --title "Caelaris Hot Switcher" 2>/dev/null || true)
        fi
    fi

    # CLI Terminal Fallback
    if [ -z "$TARGET" ] && [ -t 0 ]; then
        echo "=========================================="
        echo "        Caelaris Desktop Hot Switcher     "
        echo "=========================================="
        echo "Current session: $CURRENT"
        echo "1) KDE Plasma 6"
        echo "2) GNOME Desktop"
        echo "3) Caelestia Shell (Hyprland)"
        echo ""
        read -rp "Select target environment [1-3]: " CHOICE
        case "$CHOICE" in
            1) TARGET="plasma" ;;
            2) TARGET="gnome" ;;
            3) TARGET="hyprland" ;;
            *) echo "Invalid choice."; exit 1 ;;
        esac
    fi
fi

[ -z "$TARGET" ] && exit 0

case "$TARGET" in
    plasma|kde)
        TARGET="plasma"
        TARGET_NAME="KDE Plasma 6"
        ;;
    gnome)
        TARGET="gnome"
        TARGET_NAME="GNOME Desktop"
        ;;
    hyprland|caelestia)
        TARGET="hyprland"
        TARGET_NAME="Caelestia Shell (Hyprland)"
        ;;
    *)
        echo "Usage: caelaris-switch-desktop [plasma|gnome|hyprland]"
        exit 1
        ;;
esac

echo "[*] Switching desktop session to: ${TARGET_NAME} (${TARGET})..."

# 1. Update SDDM autologin configuration
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf << EOF
[Autologin]
User=${TARGET_USER}
Session=${TARGET}
Relogin=false
EOF

if [ -f /etc/sddm.conf.d/10-caelaris.conf ]; then
    sed -i "s/^Session=.*/Session=${TARGET}/" /etc/sddm.conf.d/10-caelaris.conf 2>/dev/null || true
fi

# 2. Update AccountsService for the active user
mkdir -p /var/lib/AccountsService/users
cat > "/var/lib/AccountsService/users/${TARGET_USER}" << EOF
[User]
Language=en_US.UTF-8
Session=${TARGET}
XSession=${TARGET}
SystemAccount=false
RealName=${TARGET_USER}
Icon=/usr/share/pixmaps/caelaris-logo.png
EOF
chmod 0644 "/var/lib/AccountsService/users/${TARGET_USER}"

# 3. Reload SDDM
echo "[*] Reloading display manager..."
systemctl restart sddm
