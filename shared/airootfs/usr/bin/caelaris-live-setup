#!/bin/bash
# caelaris-live-setup: System initialization for live session
set +e

# 1. Create liveuser if not already created by systemd-sysusers
if ! id -u liveuser >/dev/null 2>&1; then
    useradd -m -c "Caelaris Linux" -g users -G wheel,video,audio,optical,storage,input,power -s /bin/bash liveuser
fi
passwd -d liveuser 2>/dev/null || true
echo "liveuser ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/liveuser
chmod 0440 /etc/sudoers.d/liveuser

# Ensure display name is set to "Caelaris Linux" in GECOS
chfn -f "Caelaris Linux" liveuser 2>/dev/null || true

# 2. Check kernel command-line for desktop preference (dual session support)
DESKTOP_CHOICE="plasma"
if grep -q "desktop=gnome" /proc/cmdline 2>/dev/null; then
    DESKTOP_CHOICE="gnome"
fi

# Detect exact session name available
SESSION_NAME=""
if [ "$DESKTOP_CHOICE" = "gnome" ]; then
    SESSION_NAME="gnome"
else
    if [ -f /usr/share/wayland-sessions/plasma.desktop ]; then
        SESSION_NAME="plasma"
    elif [ -f /usr/share/wayland-sessions/plasmawayland.desktop ]; then
        SESSION_NAME="plasmawayland"
    elif [ -f /usr/share/xsessions/plasmax11.desktop ]; then
        SESSION_NAME="plasmax11"
    else
        SESSION_NAME="plasma"
    fi
fi

# Configure AccountsService
mkdir -p /var/lib/AccountsService/users
cat > /var/lib/AccountsService/users/liveuser << EOF
[User]
Language=en_US.UTF-8
Session=${SESSION_NAME}
XSession=${SESSION_NAME}
SystemAccount=false
RealName=Caelaris Linux
Icon=/usr/share/pixmaps/caelaris-logo.png
EOF
chmod 0644 /var/lib/AccountsService/users/liveuser

# 3. Configure SDDM autologin
mkdir -p /etc/sddm.conf.d

cat > /etc/sddm.conf.d/autologin.conf << EOF
[Autologin]
User=liveuser
Session=${SESSION_NAME}
Relogin=false
EOF

cat > /etc/sddm.conf.d/10-general.conf << 'EOF'
[General]
HaltCommand=/usr/bin/systemctl poweroff
RebootCommand=/usr/bin/systemctl reboot
EOF

# 4. Copy skeleton files & desktop shortcuts
if [ -d /etc/skel ]; then
    cp -rf /etc/skel/. /home/liveuser/
fi

# Set Caelaris icon as user face icon
if [ -f /usr/share/pixmaps/caelaris-logo.png ]; then
    cp -f /usr/share/pixmaps/caelaris-logo.png /home/liveuser/.face.icon 2>/dev/null || true
elif [ -f /usr/share/pixmaps/caelaris-logo.svg ]; then
    cp -f /usr/share/pixmaps/caelaris-logo.svg /home/liveuser/.face.icon 2>/dev/null || true
fi

# Ensure Desktop directory exists and shortcuts are executable & trusted
mkdir -p /home/liveuser/Desktop
for dfile in /home/liveuser/Desktop/*.desktop; do
    if [ -f "$dfile" ]; then
        chmod +x "$dfile" 2>/dev/null || true
        if which gio >/dev/null 2>&1; then
            gio set "$dfile" metadata::trusted true 2>/dev/null || true
        fi
    fi
done

chmod +x /usr/bin/caelaris-* 2>/dev/null || true
chmod +x /usr/bin/yay 2>/dev/null || true

# Autostart vboxclient in userspace if present
mkdir -p /home/liveuser/.config/autostart
if [ -f /etc/xdg/autostart/vboxclient.desktop ]; then
    cp -f /etc/xdg/autostart/vboxclient.desktop /home/liveuser/.config/autostart/ 2>/dev/null || true
fi

# Autostart caelaris-autoresize
cat > /home/liveuser/.config/autostart/caelaris-autoresize.desktop << 'EOF'
[Desktop Entry]
Type=Application
Exec=/usr/bin/caelaris-autoresize
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Caelaris Auto-Resize
EOF

chown -R liveuser:users /home/liveuser

# 5. Clean up releng residue
touch /root/.automated_script.sh
chmod +x /root/.automated_script.sh
exit 0
