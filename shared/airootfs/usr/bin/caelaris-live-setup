#!/bin/bash
set -e

# 1. Create liveuser if not present
if ! id -u liveuser >/dev/null 2>&1; then
    useradd -m -g users -G wheel,video,audio,optical,storage,input,power -s /bin/bash liveuser
    passwd -d liveuser || true
    echo "liveuser ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/liveuser
    chmod 0440 /etc/sudoers.d/liveuser
fi

# 2. Check kernel command-line for desktop preference
DESKTOP_CHOICE="plasma"
if grep -q "desktop=gnome" /proc/cmdline 2>/dev/null; then
    DESKTOP_CHOICE="gnome"
fi

mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf << EOF
[Autologin]
User=liveuser
Session=${DESKTOP_CHOICE}
Relogin=false
EOF

# 3. Copy skeleton files & desktop shortcuts
if [ -d /etc/skel ]; then
    cp -rf /etc/skel/. /home/liveuser/
fi

# Ensure Desktop directory exists and shortcuts are executable
mkdir -p /home/liveuser/Desktop
if [ -f /home/liveuser/Desktop/install-caelaris.desktop ]; then
    chmod +x /home/liveuser/Desktop/install-caelaris.desktop
    # Mark as trusted in KDE Plasma / GNOME
    if which gio >/dev/null 2>&1; then
        gio set /home/liveuser/Desktop/install-caelaris.desktop metadata::trusted true || true
    fi
fi

chown -R liveuser:users /home/liveuser

# 4. Configure Flathub app store backend for Discover
if which flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
fi

# 5. Clean up releng residue
touch /root/.automated_script.sh
chmod +x /root/.automated_script.sh
