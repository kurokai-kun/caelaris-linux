#!/bin/bash
# caelaris-live-setup: System initialization for live session
set +e

# Mask and terminate any lingering Plymouth services to prevent boot hang
systemctl mask --now plymouth-start.service plymouth-quit.service plymouth-quit-wait.service plymouth-reboot.service plymouth-poweroff.service plymouth-halt.service 2>/dev/null || true
killall -9 plymouth plymouthd 2>/dev/null || true

# Mask getty@tty1 so SDDM has exclusive console ownership and does not blink
systemctl mask --now getty@tty1.service 2>/dev/null || true

# 1. Completely remove default alarm user from base image
userdel -r -f alarm 2>/dev/null || true
rm -rf /home/alarm /var/lib/AccountsService/users/alarm 2>/dev/null || true

# Create liveuser with UID 1000 if not already created
if ! id -u liveuser >/dev/null 2>&1; then
    useradd -u 1000 -m -c "Caelaris Live" -g users -G wheel,video,audio,optical,storage,input,power -s /bin/bash liveuser
fi
passwd -d liveuser 2>/dev/null || true
passwd -d root 2>/dev/null || true
echo "liveuser ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/liveuser
chmod 0440 /etc/sudoers.d/liveuser

# Ensure display name is set to "Caelaris Live" in GECOS
chfn -f "Caelaris Live" liveuser 2>/dev/null || true

# 2. Check kernel command-line for desktop preference (Plasma, GNOME, or Caelestia Shell)
DESKTOP_CHOICE="plasma"
if grep -qE "desktop=caelestia|session=caelestia|desktop=hyprland|session=hyprland" /proc/cmdline 2>/dev/null; then
    DESKTOP_CHOICE="hyprland"
elif grep -qE "desktop=gnome|session=gnome" /proc/cmdline 2>/dev/null; then
    DESKTOP_CHOICE="gnome"
fi

# Set session name without .desktop suffix (SDDM expects "plasma" or "gnome")
SESSION_NAME="${DESKTOP_CHOICE}"

# Configure AccountsService
mkdir -p /var/lib/AccountsService/users
cat > /var/lib/AccountsService/users/liveuser << EOF
[User]
Language=en_US.UTF-8
Session=${SESSION_NAME}
XSession=${SESSION_NAME}
SystemAccount=false
RealName=Caelaris Live
Icon=/usr/share/pixmaps/caelaris-logo.png
EOF
chmod 0644 /var/lib/AccountsService/users/liveuser
rm -f /var/lib/AccountsService/users/alarm 2>/dev/null || true

# Configure PAM to ensure passwordless autologin and permit liveuser
mkdir -p /etc/pam.d
cat > /etc/pam.d/sddm-autologin << 'EOF'
#%PAM-1.0
auth        sufficient  pam_permit.so
auth        required    pam_env.so
account     include     system-login
password    include     system-login
session     include     system-login
EOF

cat > /etc/pam.d/sddm << 'EOF'
#%PAM-1.0
auth        sufficient  pam_permit.so
auth        include     system-login
account     include     system-login
password    include     system-login
session     include     system-login
EOF

# 3. Configure SDDM for Stable Autologin
mkdir -p /etc/sddm.conf.d

cat > /etc/sddm.conf.d/autologin.conf << EOF
[Autologin]
User=liveuser
Session=${SESSION_NAME}
Relogin=false
EOF

cat > /etc/sddm.conf.d/10-general.conf << 'EOF'
[General]
HaltCommand=/usr/bin/systemctl poweroff
RebootCommand=/usr/bin/systemctl reboot

[Theme]
Current=breeze
CursorTheme=breeze_cursors
EOF

# Ensure SDDM displays "Caelestia Shell (Hyprland)" and launches caelestia-session
if [ -f /usr/share/wayland-sessions/hyprland.desktop ]; then
    sed -i 's/^Name=.*/Name=Caelestia Shell (Hyprland)/' /usr/share/wayland-sessions/hyprland.desktop
    sed -i 's|^Exec=.*|Exec=/usr/bin/caelestia-session|' /usr/share/wayland-sessions/hyprland.desktop
    sed -i 's|^TryExec=.*|TryExec=/usr/bin/caelestia-session|' /usr/share/wayland-sessions/hyprland.desktop
fi
rm -f /usr/share/wayland-sessions/caelestia.desktop 2>/dev/null || true

# 4. Copy skeleton files & desktop shortcuts
if [ -d /etc/skel ]; then
    cp -rf /etc/skel/. /home/liveuser/
fi

# Set Caelaris icon as user face icon
if [ -f /usr/share/pixmaps/caelaris-logo.png ]; then
    cp -f /usr/share/pixmaps/caelaris-logo.png /home/liveuser/.face.icon 2>/dev/null || true
    mkdir -p /var/lib/AccountsService/icons
    cp -f /usr/share/pixmaps/caelaris-logo.png /var/lib/AccountsService/icons/liveuser 2>/dev/null || true
elif [ -f /usr/share/pixmaps/caelaris-logo.svg ]; then
    cp -f /usr/share/pixmaps/caelaris-logo.svg /home/liveuser/.face.icon 2>/dev/null || true
fi

# Ensure Desktop directory exists and shortcuts are executable & trusted
mkdir -p /home/liveuser/Desktop
for dfile in /home/liveuser/Desktop/*.desktop; do
    if [ -f "$dfile" ]; then
        chmod +x "$dfile" 2>/dev/null || true
        if which gio >/dev/null 2>&1; then
            gio set "$dfile" metadata::trusted true 2>/dev/null || true
        fi
    fi
done

chmod +x /usr/bin/caelaris-* 2>/dev/null || true
chmod +x /usr/bin/yay 2>/dev/null || true

# Autostart vboxclient in userspace if present
mkdir -p /home/liveuser/.config/autostart
if [ -f /etc/xdg/autostart/vboxclient.desktop ]; then
    cp -f /etc/xdg/autostart/vboxclient.desktop /home/liveuser/.config/autostart/ 2>/dev/null || true
fi

# Autostart caelaris-autoresize
cat > /home/liveuser/.config/autostart/caelaris-autoresize.desktop << 'EOF'
[Desktop Entry]
Type=Application
Exec=/usr/bin/caelaris-autoresize
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
Name=Caelaris Auto-Resize
EOF

# 5. Clean up desktop application menus so GNOME and KDE each have a pristine app drawer
for kapp in org.kde.dolphin dolphin org.kde.konsole konsole org.kde.kate kate \
             org.kde.kwrite kwrite org.kde.ark ark org.kde.spectacle spectacle \
             org.kde.gwenview gwenview org.kde.kcalc kcalc \
             org.kde.plasma-systemmonitor plasma-systemmonitor \
             systemsettings kinfocenter org.kde.discover org.kde.drkonqi \
             org.kde.plasma.vault org.kde.kfind org.kde.plasma.emojier; do
    for dir in /usr/share/applications /usr/local/share/applications; do
        df="${dir}/${kapp}.desktop"
        if [ -f "$df" ]; then
            sed -i '/^NotShowIn=/d; /^OnlyShowIn=/d' "$df" 2>/dev/null || true
            echo "NotShowIn=GNOME;" >> "$df" 2>/dev/null || true
        fi
    done
done

for gapp in org.gnome.Nautilus nautilus org.gnome.Ptyxis ptyxis \
             org.gnome.TextEditor gnome-text-editor org.gnome.Calculator gnome-calculator \
             org.gnome.SystemMonitor gnome-system-monitor org.gnome.DiskUtility gnome-disk-utility \
             gnome-control-center org.gnome.Settings org.gnome.Characters org.gnome.font-viewer \
             org.gnome.Logs org.gnome.Software org.gnome.Tour org.gnome.Console org.gnome.Terminal; do
    for dir in /usr/share/applications /usr/local/share/applications; do
        df="${dir}/${gapp}.desktop"
        if [ -f "$df" ]; then
            sed -i '/^NotShowIn=/d; /^OnlyShowIn=/d' "$df" 2>/dev/null || true
            echo "NotShowIn=KDE;" >> "$df" 2>/dev/null || true
        fi
    done
done

for util in avahi-discover bssh bvnc qv4l2 qvidcap lstopo cmake-gui \
            electron electron31 electron32 electron33 \
            vim nvim vi nano; do
    for dir in /usr/share/applications /usr/local/share/applications; do
        df="${dir}/${util}.desktop"
        if [ -f "$df" ]; then
            grep -q "NoDisplay=true" "$df" 2>/dev/null || echo "NoDisplay=true" >> "$df" 2>/dev/null || true
        fi
    done
done

chown -R liveuser:users /home/liveuser

# 6. Clean up releng residue
touch /root/.automated_script.sh
chmod +x /root/.automated_script.sh
exit 0
