QUARANTINE_DIR = "/var/lib/caelaris-defender/quarantine"

# ── Threat Signatures & Heuristics (Local In-Memory Rules) ─────────────────────
CRITICAL_PATTERNS = [
    # Reverse Shells
    (rb"bash\s+-i\s+>&\s+/dev/tcp/\d+\.\d+\.\d+\.\d+", "Reverse Shell Backdoor (TCP socket redirect)"),
    (rb"nc\s+-[e|c]\s+/bin/(ba)?sh", "Netcat Remote Shell Execution Backdoor"),
    (rb"python(\d)?\s+-c\s+.*import\s+socket,subprocess,os.*connect\(", "Python Remote Interactive Shell Backdoor"),
    (rb"socat\s+exec:.*pty.*tcp-connect", "Socat Remote Interactive PTY Backdoor"),
    (rb"perl\s+-e\s+.*use\s+Socket.*connect\(", "Perl Remote Socket Backdoor"),
    # Cryptominers & Botnets
    (rb"stratum\+tcp://", "Cryptominer Network Protocol (Stratum Pool)"),
    (rb"supportxmr\.com|c3pool\.org|nanopool\.org", "Known Unauthorized Mining Pool Connection"),
    (rb"kdevtmpfsi|kinsing|sysrv-hello|monerohash", "Known Linux Malware Payload / Miner"),
    # Ransomware & Wipe Indicators
    (rb"README_FOR_DECRYPT|DECRYPT_FILES|\.onion/.*decrypt", "Ransomware Extortion Signature"),
    (rb"rm\s+-rf\s+--no-preserve-root\s+/", "System Destruction / Wipe Command"),
    # Kernel & Rootkit Exploits
    (rb"/dev/mem.*mmap|/proc/kcore", "Direct Kernel Physical Memory Tampering Attempt"),
]

SUSPICIOUS_PATTERNS = [
    (rb"curl\s+-[sS]?[kK]?\s+.*\|\s*(ba)?sh", "Unverified Remote Script Pipe to Shell (curl | sh)"),
    (rb"wget\s+-[qO]?-?\s+.*\|\s*(ba)?sh", "Unverified Remote Script Pipe to Shell (wget | sh)"),
    (rb"eval\(base64_decode\(", "Obfuscated Base64 Shell Script Execution"),
    (rb"echo\s+[A-Za-z0-9+/=]{40,}\s*\|\s*base64\s+-d\s*\|\s*(ba)?sh", "Base64 Obfuscated Execution Pipeline"),
    (rb"chmod\s+\+s\s+/bin/(ba)?sh", "SUID Root Shell Escalation Persistence"),
    (rb"LD_PRELOAD=.*\.so", "Dynamic Linker Hijack / Hooking Persistence"),
]

def scan_file(filepath):
    """
    Scans a file locally in memory.
    Guaranteed: ZERO private data stored or sent outside the machine.
    Returns: (status, threat_name, level)
      level: 'CRITICAL', 'SUSPICIOUS', or 'CLEAN'
    """
    if not os.path.isfile(filepath):
        return ("CLEAN", "", "CLEAN")

    try:
        size = os.path.getsize(filepath)
        # Skip files larger than 120MB for fast memory scan
        if size > 120 * 1024 * 1024:
            return ("CLEAN", "", "CLEAN")

        with open(filepath, "rb") as f:
            chunk = f.read(512 * 1024) # Read first 512KB for deep heuristics

        # 1. Check for Critical Threats (Auto-Block)
        for pattern, desc in CRITICAL_PATTERNS:
            if re.search(pattern, chunk, re.IGNORECASE):
                return ("DETECTED", desc, "CRITICAL")

        # 2. Check for Hidden ELF binaries disguised with safe extensions
        lower_path = filepath.lower()
        if chunk.startswith(b"\x7fELF") and (lower_path.endswith(".txt") or lower_path.endswith(".png") or lower_path.endswith(".jpg") or lower_path.endswith(".pdf")):
            return ("DETECTED", "Hidden Executable (ELF Binary disguised as document/image)", "CRITICAL")

        # 3. Check for Suspicious / Warning Threats (User Choice)
        for pattern, desc in SUSPICIOUS_PATTERNS:
            if re.search(pattern, chunk, re.IGNORECASE):
                return ("DETECTED", desc, "SUSPICIOUS")

        return ("CLEAN", "", "CLEAN")
    except Exception:
        return ("CLEAN", "", "CLEAN")

def quarantine_file(filepath, reason):
    """
    Neutralizes and quarantines a dangerous file.
    Strips permissions immediately (0000) and moves it to quarantine vault.
    """
    try:
        os.makedirs(QUARANTINE_DIR, exist_ok=True)
        # Strip all execution and read permissions
        os.chmod(filepath, 0o000)
        basename = os.path.basename(filepath)
        quarantine_path = os.path.join(QUARANTINE_DIR, f"{basename}_{int(os.path.getmtime(filepath))}.blocked")
        shutil.move(filepath, quarantine_path)
        return quarantine_path
    except Exception:
        # Fallback: strip permissions in place if move fails
        try:
            os.chmod(filepath, 0o000)
        except Exception:
            pass
        return filepath

class ScannerThread(QThread):
    file_scanned_signal = pyqtSignal(str, str, str, str) # path, status, desc, level
    progress_signal = pyqtSignal(int, str)
    finished_signal = pyqtSignal(int, int) # total_scanned, threats_found

    def __init__(self, target_paths):
        super().__init__()
        self.target_paths = target_paths
        self._running = True

    def run(self):
        total_scanned = 0
        threats_found = 0

        all_files = []
        for path in self.target_paths:
            if not self._running:
                break
            if os.path.isfile(path):
                all_files.append(path)
            elif os.path.isdir(path):
                for root, _, files in os.walk(path):
                    if not self._running:
                        break
                    for f in files:
                        all_files.append(os.path.join(root, f))

        total_count = len(all_files)
        for i, fpath in enumerate(all_files):
            if not self._running:
                break
            status, desc, level = scan_file(fpath)
            total_scanned += 1

            if status == "DETECTED":
                threats_found += 1
                self.file_scanned_signal.emit(fpath, status, desc, level)

            if total_count > 0 and i % 10 == 0:
                pct = int((i / total_count) * 100)
                self.progress_signal.emit(pct, f"Scanning: {os.path.basename(fpath)}")

        self.finished_signal.emit(total_scanned, threats_found)

    def stop(self):
        self._running = False

