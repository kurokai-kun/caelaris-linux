        btn_refresh.clicked.connect(self.load_quarantine_items)
        layout.addWidget(btn_refresh, alignment=Qt.AlignmentFlag.AlignLeft)

        return page

    def trigger_quick_scan(self):
        self.content_stack.setCurrentIndex(1)
        home = os.path.expanduser("~")
        targets = [
            os.path.join(home, "Downloads"),
            "/tmp",
            "/dev/shm",
            os.path.join(home, ".config/autostart")
        ]
        self.start_scan([t for t in targets if os.path.exists(t)])

    def trigger_custom_scan(self):
        path = QFileDialog.getExistingDirectory(self, "Select Directory to Scan")
        if path:
            self.content_stack.setCurrentIndex(1)
            self.start_scan([path])

    def start_scan(self, targets):
        self.threat_table.setRowCount(0)
        self.scan_progress.setValue(0)
        self.scan_progress.setFormat("%p%")
        self.scan_progress.setStyleSheet("""
            QProgressBar {
                border: 1px solid #d5c7b8;
                border-radius: 8px;
                text-align: center;
                height: 18px;
                background-color: #eee4d8;
                color: #2d2621;
                font-weight: 700;
            }
            QProgressBar::chunk {
                background-color: #e07a5f;
                border-radius: 8px;
            }
        """)
        self.btn_stop_scan.setVisible(True)
        self.btn_stop_scan.setEnabled(True)
        self.btn_new_scan.setVisible(False)
        self.lbl_scan_status.setText("Initiating in-memory heuristic inspection...")
        self.lbl_scan_status.setStyleSheet("font-size: 12px; font-weight: 600; color: #7d7065;")

        self.active_scanner = ScannerThread(targets)
        self.active_scanner.progress_signal.connect(self.on_scan_progress)
        self.active_scanner.file_scanned_signal.connect(self.on_threat_detected)
        self.active_scanner.finished_signal.connect(self.on_scan_finished)
        self.active_scanner.start()

    def on_scan_progress(self, pct, status_text):
        self.scan_progress.setValue(pct)
        self.scan_progress.setFormat(f"{pct}%")
        self.lbl_scan_status.setText(status_text)

    def on_threat_detected(self, filepath, status, desc, level):
        row = self.threat_table.rowCount()
        self.threat_table.insertRow(row)

        self.threat_table.setItem(row, 0, QTableWidgetItem(filepath))
        self.threat_table.setItem(row, 1, QTableWidgetItem(desc))

        level_item = QTableWidgetItem(level)
        if level == "CRITICAL":
            level_item.setForeground(QColor("#d32f2f"))
        else:
            level_item.setForeground(QColor("#f57c00"))
        self.threat_table.setItem(row, 2, level_item)

        # Handle threat according to user request rules
        if level == "CRITICAL":
            # Auto-block without asking permission to prevent compromise
            qpath = quarantine_file(filepath, desc)
            action_item = QTableWidgetItem("AUTO-BLOCKED & QUARANTINED")
            action_item.setForeground(QColor("#d32f2f"))
            self.threat_table.setItem(row, 3, action_item)

            QMessageBox.critical(
                self,
                "🚨 CRITICAL SECURITY THREAT AUTO-BLOCKED",
                f"Caelaris Defender detected a SEVERE system-compromising threat:\n\n"
                f"File: {filepath}\n"
                f"Threat: {desc}\n\n"
                f"WHY IT WAS BLOCKED:\n"
                f"This file contains signatures of a rootkit, ransomware, or interactive backdoor that can compromise your kernel and steal your private data. To prevent system takeover, it was immediately stripped of execution rights and quarantined without asking for permission."
            )
        else:
            # Suspicious / Warning: Notify and ask the user for choice
            reply = QMessageBox.warning(
                self,
                "⚠️ Suspicious File Detected",
                f"Caelaris Defender detected suspicious behavior:\n\n"
                f"File: {filepath}\n"
                f"Risk: {desc}\n\n"
                f"Would you like to block and quarantine this file, or allow it to remain?",
                QMessageBox.StandardButton.Discard | QMessageBox.StandardButton.Ignore,
                QMessageBox.StandardButton.Discard
            )

            if reply == QMessageBox.StandardButton.Discard:
                quarantine_file(filepath, desc)
                self.threat_table.setItem(row, 3, QTableWidgetItem("Quarantined by User"))
            else:
                self.threat_table.setItem(row, 3, QTableWidgetItem("Allowed by User"))

    def on_scan_finished(self, total, threats):
        self.btn_stop_scan.setVisible(False)
        self.btn_new_scan.setVisible(True)
        self.scan_progress.setValue(100)
        self.scan_progress.setFormat("Completed (100%)")
        self.scan_progress.setStyleSheet("""
            QProgressBar {
                border: 1px solid #81c784;
                border-radius: 8px;
                text-align: center;
                height: 18px;
                background-color: #e8f5e9;
                color: #1b5e20;
                font-weight: 800;
            }
            QProgressBar::chunk {
                background-color: #2e7d32;
                border-radius: 8px;
            }
        """)
        self.lbl_scan_status.setText(f"✔ Completed — 100% finished. {total} files inspected. {threats} threats handled.")
        self.lbl_scan_status.setStyleSheet("font-size: 13px; font-weight: 800; color: #2e7d32;")
        self.load_quarantine_items()
        QMessageBox.information(
            self,
            "Scan Complete",
            f"Threat Inspection Finished!\n\nStatus: Completed (100%)\nFiles Scanned: {total}\nThreats Handled: {threats}\n\nZero private data was saved or transmitted."
        )

    def stop_scan(self):
        if self.active_scanner:
            self.active_scanner.stop()
            self.btn_stop_scan.setVisible(False)
            self.btn_new_scan.setVisible(True)
            self.lbl_scan_status.setText("Scan cancelled by user.")
            self.lbl_scan_status.setStyleSheet("font-size: 12px; font-weight: 700; color: #d32f2f;")

    def load_quarantine_items(self):
        self.quarantine_table.setRowCount(0)
        if not os.path.exists(QUARANTINE_DIR):
            return
        files = os.listdir(QUARANTINE_DIR)
        for f in files:
            row = self.quarantine_table.rowCount()
            self.quarantine_table.insertRow(row)
            self.quarantine_table.setItem(row, 0, QTableWidgetItem(f))
            fpath = os.path.join(QUARANTINE_DIR, f)
            mtime = os.path.getmtime(fpath)
            date_str = QDateTime.fromSecsSinceEpoch(int(mtime)).toString("yyyy-MM-dd HH:mm") if 'QDateTime' in globals() else str(int(mtime))
            self.quarantine_table.setItem(row, 1, QTableWidgetItem(date_str))
            
            btn_delete = QPushButton("Permanently Shred")
            btn_delete.setStyleSheet("background: #c62828; color: white; border-radius: 8px; padding: 4px 8px; font-weight: 700; border: none;")
            btn_delete.clicked.connect(lambda checked, p=fpath: self.shred_file(p))
            self.quarantine_table.setCellWidget(row, 2, btn_delete)

    def shred_file(self, fpath):
        try:
            if os.path.exists(fpath):
                # Zero-out content before unlinking
                with open(fpath, "wb") as f:
                    f.write(b"\x00" * 4096)
                os.remove(fpath)
            self.load_quarantine_items()
            QMessageBox.information(self, "File Shredded", "The quarantined threat has been permanently erased.")
        except Exception as e:
            QMessageBox.warning(self, "Error", f"Failed to shred file: {str(e)}")

def main():
    app = QApplication(sys.argv)
    defender = CaelarisDefender()
    defender.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
