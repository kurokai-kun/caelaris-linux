#!/usr/bin/env python3
"""
Caelaris Linux Welcome & First Steps Assistant
Robust, clean UI for first boot, hardware setup, and launching Calamares.
"""

import sys
import subprocess
import os
import tempfile

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, GLib
except ImportError:
    print("GTK3 not available. Please install python-gobject and gtk3.")
    sys.exit(1)


class CaelarisWelcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Welcome to Caelaris Linux")
        self.set_default_size(740, 540)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(18)

        for p in ["/usr/share/pixmaps/caelaris-logo.png", "/usr/share/icons/hicolor/256x256/apps/caelaris-logo.png"]:
            if os.path.isfile(p):
                self.set_icon_from_file(p)
                break

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.add(main_box)

        # Header with Logo
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        for p in ["/usr/share/pixmaps/caelaris-logo.png", "/usr/share/icons/hicolor/256x256/apps/caelaris-logo.png"]:
            if os.path.isfile(p):
                try:
                    import gi
                    gi.require_version("GdkPixbuf", "2.0")
                    from gi.repository import GdkPixbuf
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 48, 48, True)
                    img = Gtk.Image.new_from_pixbuf(pixbuf)
                    header_box.pack_start(img, False, False, 0)
                except Exception:
                    img = Gtk.Image.new_from_file(p)
                    header_box.pack_start(img, False, False, 0)
                break

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_label = Gtk.Label()
        title_label.set_markup("<span size='xx-large' weight='bold'>Caelaris Linux</span>")
        title_label.set_halign(Gtk.Align.START)
        subtitle_label = Gtk.Label(label="High-Performance Desktop Operating System")
        subtitle_label.set_halign(Gtk.Align.START)
        title_box.pack_start(title_label, False, False, 0)
        title_box.pack_start(subtitle_label, False, False, 0)
        header_box.pack_start(title_box, False, False, 0)
        main_box.pack_start(header_box, False, False, 0)

        # Notebook (Tabs)
        notebook = Gtk.Notebook()
        main_box.pack_start(notebook, True, True, 0)

        # Tab 1: Overview & Installer
        tab_general = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        tab_general.set_border_width(14)
        
        is_live = os.path.exists("/run/archiso")

        info_label = Gtk.Label()
        if is_live:
            info_label.set_markup("<b>Live Preview & System Installation:</b>")
        else:
            info_label.set_markup("<b>Welcome to Caelaris Linux:</b>")
        info_label.set_halign(Gtk.Align.START)
        tab_general.pack_start(info_label, False, False, 0)

        desc_label = Gtk.Label()
        if is_live:
            desc_label.set_text("You are currently running in the Caelaris Live Preview session. Explore the desktop, check your hardware, and test applications before installing.")
        else:
            desc_label.set_text("Welcome to your newly installed Caelaris Linux system! Get started by updating repositories, configuring software, and optimizing your hardware.")
        desc_label.set_line_wrap(True)
        desc_label.set_halign(Gtk.Align.START)
        tab_general.pack_start(desc_label, False, False, 0)

        if is_live:
            btn_install = Gtk.Button(label="==> Launch Caelaris Graphical Installer <==")
            btn_install.connect("clicked", self.launch_installer)
            tab_general.pack_start(btn_install, False, False, 0)


        btn_caelaris_update = Gtk.Button(label="⚡ Sync Caelaris Linux with GitHub & Update System (caelaris-update)")
        btn_caelaris_update.connect("clicked", self.run_terminal_command, "caelaris-update")
        tab_general.pack_start(btn_caelaris_update, False, False, 0)

        btn_update = Gtk.Button(label="Standard Arch Linux Package Update (pacman -Syu)")
        btn_update.connect("clicked", self.run_terminal_command, "sudo pacman -Syu")
        tab_general.pack_start(btn_update, False, False, 0)

        btn_codecs = Gtk.Button(label="Install Multimedia Codecs (FFmpeg, GStreamer)")
        btn_codecs.connect("clicked", self.run_terminal_command, "sudo pacman -S --needed gst-plugins-good gst-plugins-bad gst-plugins-ugly ffmpeg")
        tab_general.pack_start(btn_codecs, False, False, 0)

        btn_flathub = Gtk.Button(label="Enable Flathub App Store Backend")
        btn_flathub.connect("clicked", self.run_terminal_command, "flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo")
        tab_general.pack_start(btn_flathub, False, False, 0)

        notebook.append_page(tab_general, Gtk.Label(label="Overview"))

        # Tab 2: Hardware & Drivers
        tab_hw = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        tab_hw.set_border_width(14)

        hw_label = Gtk.Label()
        hw_label.set_markup("<b>Hardware & Graphics Drivers:</b>")
        hw_label.set_halign(Gtk.Align.START)
        tab_hw.pack_start(hw_label, False, False, 0)

        btn_nvidia = Gtk.Button(label="Install NVIDIA Proprietary Drivers (DKMS)")
        btn_nvidia.connect("clicked", self.run_terminal_command, "sudo pacman -S --needed nvidia-dkms nvidia-utils lib32-nvidia-utils")
        tab_hw.pack_start(btn_nvidia, False, False, 0)

        btn_inxi = Gtk.Button(label="View Hardware Specification Report (inxi)")
        btn_inxi.connect("clicked", self.run_terminal_command, "inxi -Fxz")
        tab_hw.pack_start(btn_inxi, False, False, 0)

        notebook.append_page(tab_hw, Gtk.Label(label="Hardware"))

        # Tab 3: Gaming Stack
        tab_gaming = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        tab_gaming.set_border_width(14)

        gaming_label = Gtk.Label()
        gaming_label.set_markup("<b>Gaming & Performance Stack:</b>")
        gaming_label.set_halign(Gtk.Align.START)
        tab_gaming.pack_start(gaming_label, False, False, 0)

        btn_steam = Gtk.Button(label="Install Steam & GameMode")
        btn_steam.connect("clicked", self.run_terminal_command, "sudo pacman -S --needed steam gamemode lib32-gamemode")
        tab_gaming.pack_start(btn_steam, False, False, 0)

        btn_wine = Gtk.Button(label="Install Wine Staging & Lutris")
        btn_wine.connect("clicked", self.run_terminal_command, "sudo pacman -S --needed wine-staging lutris winetricks")
        tab_gaming.pack_start(btn_wine, False, False, 0)

        notebook.append_page(tab_gaming, Gtk.Label(label="Gaming"))

        # Bottom Bar
        bottom_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.chk_autostart = Gtk.CheckButton(label="Show this assistant on startup")
        self.chk_autostart.set_active(True)
        bottom_box.pack_start(self.chk_autostart, False, False, 0)

        btn_close = Gtk.Button(label="Close")
        btn_close.connect("clicked", Gtk.main_quit)
        bottom_box.pack_end(btn_close, False, False, 0)

        main_box.pack_start(bottom_box, False, False, 0)

    def launch_installer(self, widget):
        if os.path.exists("/usr/bin/caelaris-installer-gui"):
            subprocess.Popen(["sudo", "-E", "/usr/bin/caelaris-installer-gui"])
            return
        if subprocess.call(["which", "calamares"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
            subprocess.Popen(["sudo", "-E", "calamares"])
            return
        self.run_terminal_command(widget, "sudo archinstall")

    def run_terminal_command(self, widget, command):
        script_file = tempfile.NamedTemporaryFile(mode="w", suffix=".sh", delete=False)
        script_file.write(f"""#!/usr/bin/env bash
echo "=========================================================="
echo " Executing: {command}"
echo "=========================================================="
echo
{command}
exit_code=$?
echo
echo "Command exited with status $exit_code."
echo "Press Enter to close this terminal window..."
read
""")
        script_file.close()
        os.chmod(script_file.name, 0o755)

        for term in ["konsole", "ptyxis", "gnome-terminal", "xterm"]:
            if subprocess.call(["which", term], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
                if term == "konsole":
                    subprocess.Popen([term, "--noclose", "-e", script_file.name])
                else:
                    subprocess.Popen([term, "--", script_file.name])
                return
        subprocess.Popen(["xterm", "-e", script_file.name])


def main():
    # If running on installed system, only show welcome once
    is_live = os.path.exists("/run/archiso")
    flag_file = os.path.expanduser("~/.config/caelaris-welcome-shown")
    if not is_live and os.path.exists(flag_file):
        sys.exit(0)

    # Mark as shown so it appears only once
    if not is_live:
        try:
            os.makedirs(os.path.dirname(flag_file), exist_ok=True)
            with open(flag_file, "w") as f:
                f.write("shown=true\n")
        except Exception:
            pass

    win = CaelarisWelcome()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()

