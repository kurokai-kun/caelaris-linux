#!/usr/bin/env bash
# ==========================================================
# Hyprland Session Launcher for Caelaris Linux
# Pure Dynamic Tiling Wayland Compositor
# ==========================================================
set +e

# 1. Clean stale Wayland display inherited from parent display manager
unset WAYLAND_DISPLAY

# 2. Session Environment Variables
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"
export QT_AUTO_SCREEN_SCALE_FACTOR="1"
export GDK_BACKEND="wayland,x11,*"
export CLUTTER_BACKEND="wayland"
export SDL_VIDEODRIVER="wayland,x11"
export MOZ_ENABLE_WAYLAND="1"
export ELECTRON_OZONE_PLATFORM_HINT="auto"

# 3. Hardware Acceleration & VM Dynamic Tuning
IS_VM=0
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
    IS_VM=1
fi

if [ "$IS_VM" = "1" ]; then
    export WLR_NO_HARDWARE_CURSORS=1
    export WLR_RENDERER_ALLOW_SOFTWARE=1
    export WLR_DRM_NO_ATOMIC=1
    export AQ_NO_ATOMIC=1
    export AQ_NO_MODIFIERS=1
    export AQ_FORCE_LINEAR=1
else
    unset AQ_NO_MODIFIERS
    unset AQ_FORCE_LINEAR
    unset AQ_NO_ATOMIC
fi
export XCURSOR_THEME="breeze_cursors"
export XCURSOR_SIZE="24"
export HYPRCURSOR_THEME="breeze_cursors"
export HYPRCURSOR_SIZE="24"

# NVIDIA Wayland Compatibility
if [ -d /dev/dri ]; then
    if lspci -k 2>/dev/null | grep -iE 'nvidia' >/dev/null 2>&1; then
        export __GLX_VENDOR_LIBRARY_NAME="nvidia"
        export NVD_BACKEND="direct"
    fi
fi

# Ensure user runtime directory exists
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# Ensure default Hyprland config is initialized in user profile
mkdir -p "$HOME/.config/hypr"
if [ ! -f "$HOME/.config/hypr/hyprland.conf" ]; then
    cat << 'EOF' > "$HOME/.config/hypr/hyprland.conf"
# Hyprland configuration for Caelaris Linux
source = /etc/hypr/hyprland.conf
EOF
fi

# Determine authoritative Hyprland configuration file
HYPR_CONF="$HOME/.config/hypr/hyprland.conf"
if [ ! -s "$HYPR_CONF" ]; then
    if [ -f /etc/hypr/hyprland.conf ]; then
        HYPR_CONF="/etc/hypr/hyprland.conf"
    elif [ -f /etc/caelestia/hyprland.conf ]; then
        HYPR_CONF="/etc/caelestia/hyprland.conf"
    fi
fi

# Launch Hyprland with explicit config
if command -v Hyprland >/dev/null 2>&1; then
    exec Hyprland --config "$HYPR_CONF"
elif command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland
else
    exec Hyprland
fi
