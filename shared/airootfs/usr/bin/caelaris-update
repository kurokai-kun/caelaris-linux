#!/usr/bin/env bash
# ==============================================================================
# Caelaris Linux System & Repository Synchronizer (caelaris-update)
# Synchronizes Caelaris OS core scripts, artwork, and configurations directly
# from the official GitHub repository (kurokai-kun/caelaris-linux) and performs
# full Arch Linux rolling-release system package upgrades.
# ==============================================================================

set -e

# ANSI Color Palette
CYAN='\033[1;36m'
BLUE='\033[1;34m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
BOLD='\033[1m'
NC='\033[0m'

# Ensure administrative privileges
if [ "$(id -u)" -ne 0 ]; then
    echo -e "${YELLOW}==>${NC} Caelaris Update requires administrative privileges."
    if command -v pkexec >/dev/null 2>&1; then
        exec pkexec "$0" "$@"
    elif command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" "$@"
    else
        echo -e "${RED}[ERROR]${NC} Neither pkexec nor sudo is available. Please run as root."
        exit 1
    fi
fi

clear 2>/dev/null || true

echo -e "${CYAN}"
cat << 'EOF'
  ____           _            _       _   _           _       _       
 / ___|__ _  ___| | __ _ _ __(_)___  | | | |_ __   __| | __ _| |_ ___ 
| |   / _` |/ _ \ |/ _` | '__| / __| | | | | '_ \ / _` |/ _` | __/ _ \
| |__| (_| |  __/ | (_| | |  | \__ \ | |_| | |_) | (_| | (_| | ||  __/
 \____\__,_|\___|_|\__,_|_|  |_|___/  \___/| .__/ \__,_|\__,_|\__\___|
                                           |_|                        
EOF
echo -e "${NC}"
echo -e "${BOLD}Caelaris Linux OTA System & Repository Synchronizer${NC}"
echo -e "Upstream Repo: https://github.com/kurokai-kun/caelaris-linux"
echo "------------------------------------------------------------------"

AUTO_CONFIRM=false
for arg in "$@"; do
    if [ "$arg" == "-y" ] || [ "$arg" == "--noconfirm" ] || [ "$arg" == "--yes" ]; then
        AUTO_CONFIRM=true
    fi
done

if [ "$AUTO_CONFIRM" = false ]; then
    echo -e "${YELLOW}This tool will:${NC}"
    echo -e " 1. Sync the latest Caelaris scripts, artwork, and optimizations from GitHub."
    echo -e " 2. Upgrade all Arch Linux system packages, kernel, and desktop software."
    echo
    read -rp "Proceed with Caelaris system update? [Y/n] " response
    response=${response,,}
    if [[ "$response" =~ ^(n|no)$ ]]; then
        echo -e "${YELLOW}[CANCELLED]${NC} Update cancelled by user."
        exit 0
    fi
fi

# Step 1: Connectivity Verification
echo
echo -e "${CYAN}[1/4] Checking network connectivity...${NC}"
if ! curl -Is --connect-timeout 8 https://github.com >/dev/null 2>&1; then
    echo -e "${RED}[ERROR]${NC} Unable to reach GitHub. Please check your internet connection."
    exit 1
fi
echo -e "${GREEN}[OK]${NC} Connected to GitHub servers."

# Step 2: Fetching Latest Caelaris Repo Assets
echo
echo -e "${CYAN}[2/4] Fetching latest Caelaris Linux updates from GitHub...${NC}"
WORKDIR=$(mktemp -d /tmp/caelaris-sync-XXXXXX)
trap 'rm -rf "$WORKDIR"' EXIT

SYNC_DIR="$WORKDIR/repo"
mkdir -p "$SYNC_DIR"

if command -v git >/dev/null 2>&1; then
    echo -e "   -> Cloning latest main branch..."
    git clone --depth 1 https://github.com/kurokai-kun/caelaris-linux.git "$SYNC_DIR" --quiet
    COMMIT_HASH=$(cd "$SYNC_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "latest")
    COMMIT_MSG=$(cd "$SYNC_DIR" && git log -1 --pretty=%B 2>/dev/null | head -n 1)
else
    echo -e "   -> Downloading main branch archive via curl..."
    curl -sSL "https://github.com/kurokai-kun/caelaris-linux/archive/refs/heads/main.tar.gz" | tar -xz -C "$WORKDIR"
    cp -rf "$WORKDIR"/caelaris-linux-main/* "$SYNC_DIR/" 2>/dev/null || true
    COMMIT_HASH="latest"
    COMMIT_MSG="Direct GitHub archive sync"
fi

echo -e "${GREEN}[OK]${NC} Synced to commit: ${BOLD}${COMMIT_HASH}${NC} (${COMMIT_MSG})"

# Step 3: In-Place Sync of Caelaris System Components
echo
echo -e "${CYAN}[3/4] Updating Caelaris system tools, desktop integrations, and artwork...${NC}"

# A. Synchronize /usr/bin/caelaris-* utilities
if [ -d "$SYNC_DIR/shared/airootfs/usr/bin" ]; then
    for tool in "$SYNC_DIR/shared/airootfs/usr/bin"/caelaris-*; do
        if [ -f "$tool" ]; then
            bname=$(basename "$tool")
            cp -f "$tool" "/usr/bin/$bname"
            chmod 755 "/usr/bin/$bname"
            echo -e "   -> Updated: /usr/bin/$bname"
        fi
    done
fi

# B. Synchronize artwork & icons (/usr/share/pixmaps)
if [ -d "$SYNC_DIR/shared/airootfs/usr/share/pixmaps" ]; then
    mkdir -p /usr/share/pixmaps
    cp -rf "$SYNC_DIR/shared/airootfs/usr/share/pixmaps/"* /usr/share/pixmaps/ 2>/dev/null || true
    echo -e "   -> Updated: Caelaris icons and brand assets (/usr/share/pixmaps)"
fi

# C. Synchronize desktop menu entries
if [ -d "$SYNC_DIR/shared/airootfs/usr/share/applications" ]; then
    mkdir -p /usr/share/applications
    for dfile in "$SYNC_DIR/shared/airootfs/usr/share/applications"/caelaris-*.desktop; do
        if [ -f "$dfile" ]; then
            cp -f "$dfile" /usr/share/applications/
            echo -e "   -> Updated: $(basename "$dfile")"
        fi
    done
fi

# D. Synchronize sysctl & performance configs
if [ -f "$SYNC_DIR/shared/airootfs/etc/sysctl.d/99-caelaris-gaming.conf" ]; then
    mkdir -p /etc/sysctl.d
    cp -f "$SYNC_DIR/shared/airootfs/etc/sysctl.d/99-caelaris-gaming.conf" /etc/sysctl.d/
    sysctl --system >/dev/null 2>&1 || true
    echo -e "   -> Updated: Gaming and low-latency sysctl rules"
fi

# E. Synchronize nobeep & hardware modprobe configs
if [ -f "$SYNC_DIR/shared/airootfs/etc/modprobe.d/nobeep.conf" ]; then
    mkdir -p /etc/modprobe.d
    cp -f "$SYNC_DIR/shared/airootfs/etc/modprobe.d/nobeep.conf" /etc/modprobe.d/
    echo -e "   -> Updated: Motherboard speaker & audio silencing configs"
fi

# F. Synchronize ZRAM generator settings
if [ -f "$SYNC_DIR/shared/airootfs/etc/systemd/zram-generator.conf" ]; then
    mkdir -p /etc/systemd
    cp -f "$SYNC_DIR/shared/airootfs/etc/systemd/zram-generator.conf" /etc/systemd/
    echo -e "   -> Updated: ZRAM compressed swap settings"
fi

# Refresh desktop & icon caches
gtk-update-icon-cache -f /usr/share/pixmaps >/dev/null 2>&1 || true
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true

# Step 4: Arch Linux Rolling Release Package Upgrade
echo
echo -e "${CYAN}[4/4] Performing Arch Linux rolling-release package upgrades...${NC}"
pacman -Syu --noconfirm

# Record sync timestamp
mkdir -p /var/log/caelaris
echo "Synced at $(date -u) with commit $COMMIT_HASH: $COMMIT_MSG" >> /var/log/caelaris/update.log

# Desktop notification if graphical session is running
if [ -n "$SUDO_USER" ]; then
    USER_ID=$(id -u "$SUDO_USER")
    USER_DBUS="unix:path=/run/user/$USER_ID/bus"
    if [ -e "/run/user/$USER_ID/bus" ]; then
        sudo -u "$SUDO_USER" DBUS_SESSION_BUS_ADDRESS="$USER_DBUS" \
            notify-send -i system-software-update "Caelaris Linux Updated" \
            "Synchronized with GitHub commit $COMMIT_HASH. Packages are up to date." 2>/dev/null || true
    fi
fi

echo
echo -e "${GREEN}================================================================${NC}"
echo -e "${BOLD}🎉 Caelaris Linux Update Completed Successfully!${NC}"
echo -e "${GREEN}================================================================${NC}"
echo -e "• Caelaris OS core tools synchronized to GitHub commit: ${BOLD}${COMMIT_HASH}${NC}"
echo -e "• All Arch Linux packages, kernel, and desktop software are up to date."
echo -e "• No reinstallation or ISO re-download required!"
echo

# Advise if reboot is recommended
if [ -f /var/run/reboot-required ] || [ "$(pacman -Q linux 2>/dev/null | awk '{print $2}')" != "$(uname -r | cut -d- -f1)" ]; then
    echo -e "${YELLOW}[NOTE]${NC} A newer Linux kernel has been installed. A system reboot is recommended."
fi
