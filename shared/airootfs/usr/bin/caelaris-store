    def create_updates_view(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(20, 30, 20, 30)
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.setSpacing(16)

        icon_lbl = QLabel("🚀")
        icon_lbl.setStyleSheet("font-size: 44px;")
        title = QLabel("Caelaris 1-Click Update Center")
        title.setStyleSheet("font-size: 22px; font-weight: 800; color: #2d2621;")
        desc = QLabel("Safely upgrade all Arch Linux official packages and verified Flathub applications without writing a single terminal command.")
        desc.setStyleSheet("font-size: 13px; color: #7d7065; max-width: 550px;")
        desc.setWordWrap(True)
        desc.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.btn_update_all = QPushButton("  ⚡ Update All Applications & System (1-Click)")
        self.btn_update_all.setStyleSheet("""
            QPushButton {
                background: #0284c7;
                color: #ffffff;
                font-size: 15px;
                font-weight: 800;
                padding: 14px 28px;
                border-radius: 16px;
                border: none;
            }
            QPushButton:hover {
                background: #0369a1;
            }
        """)
        self.btn_update_all.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_update_all.clicked.connect(self.run_one_click_update)

        layout.addWidget(icon_lbl)
        layout.addWidget(title)
        layout.addWidget(desc)
        layout.addWidget(self.btn_update_all)
        return page

    def refresh_installed_cache(self):
        self.installed_cache.clear()
        self.updates_cache.clear()

        # Check Flatpaks
        if shutil.which("flatpak"):
            try:
                res = subprocess.run(["flatpak", "list", "--app", "--columns=application"], stdout=subprocess.PIPE, text=True)
                for line in res.stdout.splitlines():
                    if line.strip():
                        self.installed_cache.add(line.strip())
            except Exception:
                pass

        # Check Pacman
        if shutil.which("pacman"):
            try:
                res = subprocess.run(["pacman", "-Qq"], stdout=subprocess.PIPE, text=True)
                for line in res.stdout.splitlines():
                    if line.strip():
                        self.installed_cache.add(line.strip())
            except Exception:
                pass

        # Check for Available Updates (non-blocking)
        threading.Thread(target=self._check_available_updates, daemon=True).start()

    def _check_available_updates(self):
        # Check flatpak updates
        if shutil.which("flatpak"):
            try:
                res = subprocess.run(["flatpak", "remote-ls", "--updates"], stdout=subprocess.PIPE, text=True)
                for line in res.stdout.splitlines():
                    parts = line.split()
                    if parts:
                        self.updates_cache.add(parts[0].strip())
            except Exception:
                pass

    def is_app_installed(self, app_info):
        app_id = app_info["app_id"]
        pkg = app_info.get("pkg", "")
        app_type = app_info.get("type", "flatpak")
        if app_type == "system":
            return True
        if app_type == "flatpak":
            return app_id in self.installed_cache
        if app_type == "pacman":
            return pkg in self.installed_cache
        return (app_id in self.installed_cache) or (pkg in self.installed_cache)

    def has_update(self, app_info):
        return (app_info["app_id"] in self.updates_cache) or (app_info.get("pkg", "") in self.updates_cache)

    def populate_catalog(self, filter_text=""):
        # Clear existing cards
        while self.apps_grid.count():
            item = self.apps_grid.takeAt(0)
            widget = item.widget()
            if widget:
                widget.deleteLater()

        col_count = 2
        row = 0
        col = 0
        filter_lower = filter_text.strip().lower()

        for app in VERIFIED_CATALOG:
            if self.current_category != "All" and app["cat"] != self.current_category:
                continue

            if filter_lower:
                text_corpus = f"{app['name']} {app['desc']} {app['pub']} {app['cat']}".lower()
                if filter_lower not in text_corpus:
                    continue

            card = self.create_app_card(app)
            self.apps_grid.addWidget(card, row, col)
            col += 1
            if col >= col_count:
                col = 0
                row += 1

    def create_app_card(self, app_info):
        card = QFrame()
        card.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Minimum)
        card.setStyleSheet("""
            QFrame {
                background: #ffffff;
                border: 1px solid #e4dbd1;
                border-radius: 18px;
            }
            QFrame:hover {
                border: 1px solid #0284c7;
            }
        """)
        c_layout = QHBoxLayout(card)
        c_layout.setContentsMargins(16, 14, 16, 14)
        c_layout.setSpacing(14)

        # Real App Logo
        icon_box = QLabel()
        icon_box.setFixedSize(52, 52)
        icon_box.setAlignment(Qt.AlignmentFlag.AlignCenter)
        real_pixmap = self.get_real_app_icon(app_info)
        icon_box.setPixmap(real_pixmap.scaled(48, 48, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
        c_layout.addWidget(icon_box)

        # Info Box
        info_layout = QVBoxLayout()
        info_layout.setSpacing(3)

        name_layout = QHBoxLayout()
        lbl_name = QLabel(app_info["name"])
        lbl_name.setStyleSheet("font-size: 14px; font-weight: 800; color: #2d2621;")
        
        badge = QLabel("✓ Verified")
        badge.setStyleSheet("background: #e8f5e9; color: #2e7d32; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 8px;")
        name_layout.addWidget(lbl_name)
        name_layout.addWidget(badge)

        installed = self.is_app_installed(app_info)
        if installed:
            inst_badge = QLabel("Installed")
            inst_badge.setStyleSheet("background: #e0f2fe; color: #0284c7; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 8px;")
            name_layout.addWidget(inst_badge)

        if self.has_update(app_info):
            up_badge = QLabel("⚡ Update Available")
            up_badge.setStyleSheet("background: #fef3c7; color: #d97706; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 8px;")
            name_layout.addWidget(up_badge)

        name_layout.addStretch()
        info_layout.addLayout(name_layout)

        lbl_desc = QLabel(app_info["desc"])
        lbl_desc.setWordWrap(True)
        lbl_desc.setStyleSheet("font-size: 11px; color: #6d6157;")
        info_layout.addWidget(lbl_desc)

        lbl_pub = QLabel(f"Publisher: {app_info['pub']} • {app_info['type'].upper()}")
        lbl_pub.setStyleSheet("font-size: 10px; color: #9c8e82; font-weight: 600;")
        info_layout.addWidget(lbl_pub)

        c_layout.addLayout(info_layout, 1)

        # Action Buttons
        btn_layout = QVBoxLayout()
        btn_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        btn_layout.setSpacing(6)

        if installed:
            btn_launch = QPushButton("▶ Launch")
            btn_launch.setStyleSheet("""
                QPushButton {
                    background: #0284c7;
                    color: white;
                    font-weight: 800;
                    padding: 8px 16px;
                    border-radius: 12px;
                    border: none;
                }
                QPushButton:hover { background: #0369a1; }
            """)
            btn_launch.setCursor(Qt.CursorShape.PointingHandCursor)
            btn_launch.clicked.connect(lambda checked, a=app_info: self.launch_app(a))
            btn_layout.addWidget(btn_launch)

            if self.has_update(app_info):
                btn_update = QPushButton("⚡ Update")
                btn_update.setStyleSheet("""
                    QPushButton {
                        background: #d97706;
                        color: white;
                        font-weight: 800;
                        padding: 6px 14px;
                        border-radius: 10px;
                        border: none;
                    }
                    QPushButton:hover { background: #b45309; }
                """)
                btn_update.setCursor(Qt.CursorShape.PointingHandCursor)
                btn_update.clicked.connect(lambda checked, a=app_info: self.trigger_install(a, "update"))
                btn_layout.addWidget(btn_update)

            if app_info.get("type") != "system":
                btn_del = QPushButton("Uninstall")
                btn_del.setStyleSheet("""
                    QPushButton {
                        background: transparent;
                        color: #c62828;
                        font-size: 10px;
                        font-weight: 600;
                        border: none;
                    }
                    QPushButton:hover { text-decoration: underline; }
                """)
                btn_del.setCursor(Qt.CursorShape.PointingHandCursor)
                btn_del.clicked.connect(lambda checked, a=app_info: self.trigger_install(a, "remove"))
                btn_layout.addWidget(btn_del)
        else:
            btn_install = QPushButton("Install")
            btn_install.setStyleSheet("""
                QPushButton {
                    background: #e07a5f;
                    color: white;
                    font-weight: 800;
                    padding: 8px 20px;
                    border-radius: 12px;
                    border: none;
                }
                QPushButton:hover { background: #f28a6f; }
            """)
            btn_install.setCursor(Qt.CursorShape.PointingHandCursor)
            btn_install.clicked.connect(lambda checked, a=app_info: self.trigger_install(a, "install"))
            btn_layout.addWidget(btn_install)

        c_layout.addLayout(btn_layout)
        return card

    def on_nav_clicked(self, category):
        self.current_category = category
        if category == "Updates":
            self.content_stack.setCurrentIndex(1)
        else:
            self.content_stack.setCurrentIndex(0)
            self.populate_catalog(self.search_box.text())

    def on_search_changed(self, text):
        self.content_stack.setCurrentIndex(0)
        self.populate_catalog(text)

    def reload_catalog(self):
        self.refresh_installed_cache()
        self.populate_catalog(self.search_box.text())

    def trigger_install(self, app_info, action):
        self.downloader_panel.setVisible(True)
        self.d_title.setText(f"{'Installing' if action == 'install' else 'Updating' if action == 'update' else 'Removing'} {app_info['name']}...")
        self.d_progress.setValue(5)
        self.d_stats.setText("⚡ Net Speed: Calculating...  •  ⏱ Time Remaining: --")
        self.d_status.setText("Initiating verified cryptographic download...")

        self.worker = InstallWorker(app_info, action)
        self.worker.progress_signal.connect(self.on_download_progress)
        self.worker.finished_signal.connect(self.on_worker_finished)
        self.worker.start()

    def on_download_progress(self, pct, speed, eta, status):
        self.d_progress.setValue(pct)
        self.d_stats.setText(f"⚡ Net Speed: {speed}  •  ⏱ Time Remaining: {eta}")
        self.d_status.setText(status)

    def on_worker_finished(self, success, message):
        self.downloader_panel.setVisible(False)
        if success:
            QMessageBox.information(self, "Caelaris Store", message)
            self.reload_catalog()
        else:
            QMessageBox.warning(self, "Caelaris Store Notice", message)

    def launch_app(self, app_info):
        app_id = app_info["app_id"]
        pkg = app_info.get("pkg", "")
        # Try gtk-launch, flatpak run, or direct binary
        try:
            if app_info.get("type") == "flatpak":
                subprocess.Popen(["flatpak", "run", app_id])
            elif shutil.which("gtk-launch"):
                subprocess.Popen(["gtk-launch", app_id])
            elif shutil.which(pkg):
                subprocess.Popen([pkg])
            elif shutil.which(app_id):
                subprocess.Popen([app_id])
        except Exception as e:
            QMessageBox.warning(self, "Launch Error", f"Could not launch application: {e}")

    def run_one_click_update(self):
        self.btn_update_all.setEnabled(False)
        self.downloader_panel.setVisible(True)
        self.d_title.setText("Upgrading all verified applications & system packages...")
        self.d_progress.setValue(10)

        self.up_worker = UpdateWorker()
        self.up_worker.progress_signal.connect(self.on_download_progress)
        self.up_worker.finished_signal.connect(self.on_update_finished)
        self.up_worker.start()

    def on_update_finished(self, success, message):
        self.btn_update_all.setEnabled(True)
        self.downloader_panel.setVisible(False)
        QMessageBox.information(self, "Caelaris Update Complete", message)
        self.reload_catalog()

def main():
    app = QApplication(sys.argv)
    window = CaelarisStore()
    window.show()
    sys.exit(app.exec())

if __name__ == "__main__":
    main()
