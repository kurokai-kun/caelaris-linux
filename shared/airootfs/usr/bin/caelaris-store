        top_bar.addWidget(self.btn_refresh, 1)
        m_layout.addLayout(top_bar)

        # ── 3. Dedicated Live Downloader Panel ─────────────────────────────
        self.downloader_panel = QFrame()
        self.downloader_panel.setStyleSheet("""
            QFrame {
                background: #ffffff;
                border: 2px solid #0284c7;
                border-radius: 16px;
                padding: 12px;
            }
        """)
        self.downloader_panel.setVisible(False)
        d_layout = QVBoxLayout(self.downloader_panel)
        d_layout.setSpacing(6)

        d_top = QHBoxLayout()
        self.d_title = QLabel("Downloading Application...")
        self.d_title.setStyleSheet("font-size: 13px; font-weight: 800; color: #0284c7;")
        self.d_stats = QLabel("⚡ Net Speed: 0 MB/s  •  ⏱ Time Remaining: --")
        self.d_stats.setStyleSheet("font-size: 12px; font-weight: 700; color: #475569;")
        d_top.addWidget(self.d_title)
        d_top.addStretch()
        d_top.addWidget(self.d_stats)
        d_layout.addLayout(d_top)

        self.d_progress = QProgressBar()
        self.d_progress.setStyleSheet("""
            QProgressBar {
                border: 1px solid #cbd5e1;
