        d_layout.addWidget(self.d_status)

        m_layout.addWidget(self.downloader_panel)

        # Stacked Views
        self.content_stack = QStackedWidget()

        # View 1: Scrollable Apps Catalog
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
