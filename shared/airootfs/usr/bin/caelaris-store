class InstallWorker(QThread):
    progress_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool, str)

    def __init__(self, app_info, action="install"):
        super().__init__()
        self.app_info = app_info
        self.action = action

    def run(self):
        name = self.app_info["name"]
        app_id = self.app_info["app_id"]
        pkg = self.app_info.get("pkg", "")
        app_type = self.app_info.get("type", "flatpak")

        self.progress_signal.emit(f"Preparing to {self.action} {name}...")

        try:
            if app_type == "flatpak":
                # Ensure flathub remote is configured
                subprocess.run(["flatpak", "remote-add", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"], stderr=subprocess.DEVNULL)
                if self.action == "install":
                    self.progress_signal.emit(f"Downloading verified package for {name} from Flathub...")
                    cmd = ["flatpak", "install", "-y", "--noninteractive", "flathub", app_id]
                    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                    if res.returncode == 0:
                        self.finished_signal.emit(True, f"Successfully installed {name}!")
                    else:
                        self.finished_signal.emit(False, f"Installation failed: {res.stderr}")
                else: # remove
                    self.progress_signal.emit(f"Removing {name}...")
                    cmd = ["flatpak", "uninstall", "-y", "--noninteractive", app_id]
                    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                    self.finished_signal.emit(True, f"Successfully removed {name}.")
            elif app_type == "pacman":
                if self.action == "install":
                    self.progress_signal.emit(f"Downloading verified GPG-signed package {pkg}...")
                    cmd = ["pkexec", "pacman", "-S", "--noconfirm", "--needed", pkg]
                    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                    if res.returncode == 0:
                        self.finished_signal.emit(True, f"Successfully installed {name}!")
                    else:
                        self.finished_signal.emit(False, f"Installation error: {res.stderr}")
                else:
                    self.progress_signal.emit(f"Uninstalling {pkg}...")
                    cmd = ["pkexec", "pacman", "-R", "--noconfirm", pkg]
                    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                    self.finished_signal.emit(True, f"Successfully removed {name}.")
            else:
                self.finished_signal.emit(True, f"{name} is a built-in system component.")
        except Exception as e:
            self.finished_signal.emit(False, str(e))

class UpdateWorker(QThread):
    progress_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool, str)

    def run(self):
        try:
            self.progress_signal.emit("Refreshing Arch Linux official cryptographic databases...")
            subprocess.run(["pkexec", "pacman", "-Sy", "--noconfirm"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            
            self.progress_signal.emit("Upgrading all verified system packages...")
            res1 = subprocess.run(["pkexec", "pacman", "-Su", "--noconfirm"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

            self.progress_signal.emit("Checking Flathub verified application updates...")
            subprocess.run(["flatpak", "update", "-y", "--noninteractive"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

            self.finished_signal.emit(True, "All applications and system packages are fully up-to-date!")
        except Exception as e:
            self.finished_signal.emit(False, f"Update encountered an error: {str(e)}")

