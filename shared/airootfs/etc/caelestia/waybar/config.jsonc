{
    "layer": "top",
    "position": "left",
    "width": 52,
    "margin-top": 12,
    "margin-bottom": 12,
    "margin-left": 12,
    "spacing": 8,
    "modules-left": [
        "custom/launcher",
        "custom/dashboard",
        "custom/media",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/desktop-label"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "battery",
        "clock",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "✦",
        "on-click": "caelestia-dashboard || rofi -show drun -theme /etc/caelestia/rofi.rasi || wofi --show drun",
        "tooltip": "Caelestia Shell"
    },
    "custom/dashboard": {
        "format": "󰕮",
        "on-click": "caelestia-dashboard || rofi -show drun -theme /etc/caelestia/rofi.rasi",
        "tooltip": "Dashboard"
    },
    "custom/media": {
        "format": "",
        "on-click": "feishin || vlc || elisa || playerctl play-pause",
        "tooltip": "Media Player"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "custom/desktop-label": {
        "format": "󰍹",
        "tooltip": "Desktop"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "⚠",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "nm-connection-editor || konsole -e nmtui"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}%"
    },
    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout || systemctl poweroff",
        "tooltip": "Power Menu"
    }
}
